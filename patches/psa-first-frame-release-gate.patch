diff --git a/common/src/test/java/com/shilapi/xcertplay/PsaFirstFrameReleaseGateTest.kt b/common/src/test/java/com/shilapi/xcertplay/PsaFirstFrameReleaseGateTest.kt
new file mode 100644
index 0000000..ebe2267
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/PsaFirstFrameReleaseGateTest.kt
@@ -0,0 +1,103 @@
+package com.shilapi.xcertplay
+
+import android.content.Intent
+import android.view.View
+import android.widget.TextView
+import com.shilapi.xcertplay.orchestration.CarPlayController
+import java.time.Duration
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.atomic.AtomicBoolean
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.Mockito.*
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+@LooperMode(LooperMode.Mode.PAUSED)
+class PsaFirstFrameReleaseGateTest {
+    private fun field(a: CarPlayHostActivity, name: String) = a.javaClass.getDeclaredField(name).apply { isAccessible = true }
+    private fun call(a: CarPlayHostActivity, name: String, vararg args: Any) {
+        val types = args.map { when(it) { is Int -> Int::class.javaPrimitiveType!!; else -> it.javaClass } }.toTypedArray()
+        a.javaClass.getDeclaredMethod(name, *types).apply { isAccessible = true }.invoke(a, *args)
+    }
+    private fun withHost(test: (CarPlayHostActivity, CarPlayController) -> Unit) {
+        val a = Robolectric.buildActivity(CarPlayHostActivity::class.java).get()
+        val controller = mock(CarPlayController::class.java)
+        `when`(controller.awaitClosed(anyLong())).thenReturn(true)
+        call(a, "buildContentView")
+        field(a,"controller").set(a,controller)
+        try { test(a,controller) } finally {
+            call(a,"cancelFirstFrameWait")
+            (field(a,"shuttingDown").get(a) as AtomicBoolean).set(true)
+            for(name in listOf("teardownExecutor","airPlayCommandExecutor"))
+                (field(a,name).get(a) as ExecutorService).shutdownNow()
+            CarPlayBackgroundSession.closed(controller); CarPlayBackgroundSession.clear()
+        }
+    }
+    @Test fun controllerAndHandshakeStatusesNeverRevealBlackVideo() = withHost { a,_ ->
+        for(status in listOf("Controller started","Network connected","AirPlay SETUP","Video decoder initialized")) {
+            call(a,"setConnectionStage",status)
+            assertEquals(View.VISIBLE,(field(a,"connectionPanel").get(a) as View).visibility)
+        }
+        call(a,"onFirstFrameRendered",0,110) // A callback without the main stream is insufficient.
+        assertFalse(field(a,"mainFirstFrameReady").getBoolean(a))
+    }
+    @Test fun noVideoDeadlineReturnsHomeAndKeepsFailureDistinctFromSuccess() = withHost { a,_ ->
+        call(a,"armFirstFrameWait")
+        shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(89))
+        assertFalse(a.isFinishing)
+        assertEquals(View.VISIBLE,(field(a,"connectionPanel").get(a) as View).visibility)
+        shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(1))
+        val intent=shadowOf(a).nextStartedActivity
+        assertEquals(DiPlayActivity::class.java.name,intent.component!!.className)
+        assertTrue(intent.getBooleanExtra("psa_first_frame_timeout",false))
+        assertTrue(a.isFinishing)
+    }
+    @Test fun staleDeadlineAndPostFirstFrameDeadlineCannotTerminateSession() = withHost { a,_ ->
+        call(a,"armFirstFrameWait")
+        call(a,"onFirstFrameTimeout",-1)
+        @Suppress("UNCHECKED_CAST")
+        (field(a,"activeScreenStreamTypes").get(a) as MutableSet<Int>).add(110)
+        call(a,"onFirstFrameRendered",0,110)
+        shadowOf(android.os.Looper.getMainLooper()).idleFor(Duration.ofSeconds(100))
+        assertFalse(a.isFinishing); assertNull(shadowOf(a).nextStartedActivity)
+        assertEquals(View.GONE,(field(a,"connectionPanel").get(a) as View).visibility)
+    }
+    @Test fun pausedSessionCannotArmOrExecuteADisplayTimeout() = withHost { a,_ ->
+        field(a,"firstFrameWaitSuspended").setBoolean(a,true)
+        call(a,"armFirstFrameWait")
+        call(a,"onFirstFrameTimeout",0)
+        assertNull(field(a,"firstFrameTimeout").get(a))
+        assertFalse(a.isFinishing)
+    }
+    @Test fun duplicateUsbAttachReusesWiredOwnerWithoutAnotherController() = withHost { a,c ->
+        field(a,"wirelessEnabled").setBoolean(a,false)
+        val intent=Intent("android.hardware.usb.action.USB_DEVICE_ATTACHED")
+        repeat(5) { call(a,"onNewIntent",intent) }
+        assertSame(c,field(a,"controller").get(a))
+        verify(c,never()).start(); verify(c,never()).close()
+        assertNull(shadowOf(a).nextStartedActivity)
+    }
+    @Test fun staleSurfaceSizeCallbackCannotRenegotiateCurrentDisplay() = withHost { a,_ ->
+        val stale=mock(android.graphics.SurfaceTexture::class.java)
+        val current=mock(android.graphics.SurfaceTexture::class.java)
+        field(a,"currentSurfaceTexture").set(a,current)
+        val listener=field(a,"textureListener").get(a) as android.view.TextureView.SurfaceTextureListener
+        listener.onSurfaceTextureSizeChanged(stale,1,1)
+        assertNull(field(a,"pendingDisplaySize").get(a))
+    }
+    @Test fun homeShowsRecoverableFailureAcrossStatusRefreshes() {
+        val a=Robolectric.buildActivity(DiPlayActivity::class.java).get()
+        a.intent=Intent().putExtra("psa_first_frame_timeout",true)
+        for(name in listOf("consumeConnectionFailure","render","refreshStatus","refreshStatus"))
+            a.javaClass.getDeclaredMethod(name).apply { isAccessible=true }.invoke(a)
+        val status=a.javaClass.getDeclaredField("status").apply { isAccessible=true }.get(a) as TextView
+        assertEquals(a.getString(com.shilapi.xcertplay.host.R.string.psa_first_frame_timeout),status.text.toString())
+    }
+}
