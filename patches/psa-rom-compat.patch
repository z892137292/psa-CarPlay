+import org.robolectric.annotation.Config
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+class PsaSurfaceLifecycleTest {
+    @Test fun oldSurfaceDestructionDoesNotDetachTheNewH264Target() {
+        val firstTexture = SurfaceTexture(1); val secondTexture = SurfaceTexture(2)
+        val first = Surface(firstTexture); val second = Surface(secondTexture)
+        val sink = AndroidMediaSink()
+        try {
+            sink.setSurface(110, first); sink.setSurface(110, second)
+            sink.clearSurface(110, first)
+            val targets = sink.javaClass.getDeclaredField("surfaces").apply { isAccessible = true }.get(sink) as Map<*, *>
+            assertSame(second, targets[110])
+            sink.clearSurface(110, second)
+            assertNull(targets[110])
+        } finally {
+            sink.close(); first.release(); second.release(); firstTexture.release(); secondTexture.release()
+        }
+    }
+}
