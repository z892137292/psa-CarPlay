@@ -0,0 +1,10 @@
+package com.shilapi.xcertplay
+
+/** Preserve transitions/faults; periodic successful media counters require diagnostic mode. */
+internal object PsaDiagnosticPolicy {
+    fun isVerbose(line: String): Boolean {
+        if (Regex("(?i)(failed|failure|error=|error:|writeErrors=[1-9]|crash|disconnect|first frame|CONNECTION_DIAGNOSTIC)").containsMatchIn(line)) return false
+        return line.contains("audio stats ", true) || line.contains("video stats ", true) ||
+            line.startsWith("TRACE ") || line.contains("decoded buffer", true)
+    }
+}
