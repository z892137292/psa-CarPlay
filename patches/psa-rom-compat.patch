@@ -0,0 +1,35 @@
+package com.shilapi.xcertplay.media
+
+/** Small boundary for vendor framework failures; VM failures are deliberately not swallowed. */
+internal object RomAudioGuard {
+    fun attempt(report: (Throwable) -> Unit, operation: () -> Unit): Boolean = try {
+        operation()
+        true
+    } catch (error: Exception) {
+        runCatching { report(error) }
+        false
+    } catch (error: LinkageError) {
+        runCatching { report(error) }
+        false
+    }
+
+    /** Publish a decoder only after configuration succeeds; release partial construction. */
+    fun <T> initialize(create: () -> T, configure: (T) -> Unit, release: (T) -> Unit): T {
+        val resource = create()
+        try {
+            configure(resource)
+            return resource
+        } catch (error: Exception) {
+            attempt({}, { release(resource) })
+            throw error
+        } catch (error: LinkageError) {
+            attempt({}, { release(resource) })
+            throw error
+        }
+    }
+
+    fun <T> requireInitialized(track: T, initialized: (T) -> Boolean): T {
+        check(initialized(track)) { "AudioTrack initialization failed" }
+        return track
+    }
+}
