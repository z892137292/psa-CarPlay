@@ -0,0 +1,54 @@
+package com.shilapi.xcertplay.media
+
+import android.media.AudioTrack
+import android.media.MediaCodec
+import com.shilapi.xcertplay.airplay.AudioCodecKind
+import com.shilapi.xcertplay.airplay.AudioFormat
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.Implementation
+import org.robolectric.annotation.Implements
+
+/** Execute the real private renderer worker with a deliberately incomplete API-28 ROM. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE, shadows = [PsaRomAudioWorkerTest.MissingTrackApi::class, PsaRomAudioWorkerTest.MissingDecoderApi::class])
+class PsaRomAudioWorkerTest {
+    @Implements(AudioTrack::class)
+    class MissingTrackApi {
+        companion object {
+            @JvmStatic @Implementation
+            fun getMinBufferSize(rate: Int, mask: Int, encoding: Int): Int {
+                throw NoSuchMethodError("simulated vendor audio API missing")
+            }
+        }
+    }
+    @Implements(MediaCodec::class)
+    class MissingDecoderApi {
+        companion object {
+            @JvmStatic @Implementation
+            fun createDecoderByType(mime: String): MediaCodec {
+                throw IllegalStateException("simulated decoder creation failure")
+            }
+        }
+    }
+    private fun runWorker(codec: AudioCodecKind): List<String> {
+        val reports = mutableListOf<String>()
+        val type = Class.forName("com.shilapi.xcertplay.media.AudioRenderer")
+        val renderer = type.declaredConstructors.single().apply { isAccessible = true }.newInstance(
+            AudioFormat(codec, 48000, 2, 100), false, false, 0, 0,
+            AudioFocusCoordinator(null, false), 0, 120, { line: String -> reports.add(line); Unit })
+        type.getDeclaredMethod("run").apply { isAccessible = true }.invoke(renderer)
+        assertFalse(type.getDeclaredField("running").apply { isAccessible = true }.getBoolean(renderer))
+        assertFalse(reports.any { it.contains("Audio: ready") })
+        return reports
+    }
+    @Test fun missingFrameworkMethodCannotEscapeRealAudioWorker() {
+        assertTrue(runWorker(AudioCodecKind.LPCM).any { it.contains("unsupported ROM API") && it.contains("NoSuchMethodError") })
+    }
+    @Test fun decoderCreationFailureIsRecordedAndCannotKillApp() {
+        assertTrue(runWorker(AudioCodecKind.AAC_LC).any { it.contains("renderer failed") && it.contains("IllegalStateException") })
+    }
+}
