@@ -0,0 +1,34 @@
+package com.shilapi.xcertplay
+import java.nio.file.Files
+import org.junit.Assert.*
+import org.junit.Test
+class PsaDiagnosticRetentionTest {
+    @Test fun filesRotateBeforeExceedingLimitAndRecentFaultSurvives() {
+        val folder = Files.createTempDirectory("psa-retention").toFile()
+        try {
+            SessionLogFile(folder.resolve("diplay.log")).use { log ->
+                repeat(7000) { log.append("event=" + "x".repeat(650)) }
+                log.append("Audio: renderer failed error=NoSuchMethodError")
+            }
+            val files = folder.listFiles()!!
+            assertTrue(files.size <= 8)
+            assertTrue(files.all { it.length() <= SessionLogFile.MAX_BYTES })
+            assertTrue(folder.resolve("diplay.log").readText().contains("NoSuchMethodError"))
+        } finally { folder.deleteRecursively() }
+    }
+    @Test fun disconnectArchivesDoNotOverwriteAudioVideoEvidence() {
+        val folder = Files.createTempDirectory("psa-separated-retention").toFile()
+        try {
+            folder.resolve("previous.log").writeText("Audio: renderer failed")
+            SessionLogFile(folder.resolve("disconnect.log")).use { log -> repeat(900) { log.append("disconnect " + "x".repeat(650)) } }
+            assertEquals("Audio: renderer failed", folder.resolve("previous.log").readText())
+            assertTrue(folder.resolve("disconnect-previous-1.log").exists())
+        } finally { folder.deleteRecursively() }
+    }
+    @Test fun detailedCountersRequireDebugButFaultsAndFirstFrameDoNot() {
+        assertTrue(PsaDiagnosticPolicy.isVerbose("audio stats rx=100"))
+        assertFalse(PsaDiagnosticPolicy.isVerbose("audio stats writeErrors=3"))
+        assertFalse(PsaDiagnosticPolicy.isVerbose("Video: first frame rendered"))
+        assertFalse(PsaDiagnosticPolicy.isVerbose("Audio: cleanup failed"))
+    }
+}
