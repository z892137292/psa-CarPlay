+package com.shilapi.xcertplay
+
+import android.content.Intent
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+import java.util.concurrent.ExecutorService
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28])
+@LooperMode(LooperMode.Mode.PAUSED)
+class PsaLauncherReturnTest {
+    @Test fun wifiSettingsDoesNotInsertALauncherHomeHop() {
+        val activity = Robolectric.buildActivity(DiPlayActivity::class.java).get()
+        val info = android.content.pm.ResolveInfo().apply {
+            activityInfo = android.content.pm.ActivityInfo().apply { packageName = "com.byd.carsettings"; name = "WifiSettings"; exported = true }
+        }
+        shadowOf(activity.packageManager).addResolveInfoForIntent(Intent(android.provider.Settings.ACTION_WIFI_SETTINGS), info)
+        activity.javaClass.getDeclaredMethod("openCarClientWifiSettings").apply { isAccessible = true }.invoke(activity)
+        val intent = shadowOf(activity).nextStartedActivity
+        assertEquals(android.provider.Settings.ACTION_WIFI_SETTINGS, intent.action)
+        assertFalse(intent.hasCategory(Intent.CATEGORY_HOME))
+        assertNull(shadowOf(activity).nextStartedActivity)
+    }
+
+    @Test fun terminalDisconnectStartsPsaHomeInsteadOfLauncherHomeIntent() {
+        val activity = Robolectric.buildActivity(CarPlayHostActivity::class.java).get()
+        try {
+            activity.javaClass.getDeclaredMethod("buildContentView").apply { isAccessible = true }.invoke(activity)
+            activity.javaClass.getDeclaredMethod("returnHomeAfterConfirmedLoss", String::class.java, Long::class.javaPrimitiveType)
+                .apply { isAccessible = true }.invoke(activity, "TEST_TERMINAL", System.nanoTime())
+            val intent = shadowOf(activity).nextStartedActivity
+            assertEquals(DiPlayActivity::class.java.name, intent.component!!.className)
+            assertEquals("home", intent.getStringExtra("page"))
+            assertTrue(intent.flags and Intent.FLAG_ACTIVITY_CLEAR_TOP != 0)
+            assertFalse(intent.hasCategory(Intent.CATEGORY_HOME))
+            assertTrue(activity.isFinishing)
+        } finally {
+            for (name in listOf("teardownExecutor", "airPlayCommandExecutor"))
+                (activity.javaClass.getDeclaredField(name).apply { isAccessible = true }.get(activity) as ExecutorService).shutdownNow()
+        }
+    }
+}
