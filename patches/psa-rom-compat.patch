+package com.shilapi.xcertplay.network
+import org.junit.Assert.*
+import org.junit.Test
+class PsaStationLinkTest {
+    private val sta = LanNetworkCandidate(1, "wlan0", setOf("192.0.2.21"))
+    private val ap = LanNetworkCandidate(2, "ap0", setOf("198.51.100.1"))
+    private val ip = 192 or (0 shl 8) or (2 shl 16) or (21 shl 24)
+    @Test fun systemHotspotDefaultCannotOverrideActualStationAddress() {
+        val candidates = LanNetworkSelection.stationCandidates(listOf(ap, sta), ip)
+        assertEquals(sta, LanNetworkSelection.choose(candidates, ap.handle))
+    }
+    @Test fun interfaceNamesAreNotDeviceConstants() {
+        val renamed = sta.copy(interfaceName = "wifi_vendor42")
+        assertEquals(renamed, LanNetworkSelection.stationCandidates(listOf(ap, renamed), ip).single())
+    }
+    @Test fun duplicateStationHandlesRemainValid() {
+        val alias = sta.copy(handle = 3)
+        assertEquals(alias, LanNetworkSelection.choose(LanNetworkSelection.stationCandidates(listOf(sta, ap, alias), ip), 3))
+    }
+    @Test fun unavailableIpv4RetainsIpv6AndExistingAmbiguityChecks() {
+        assertEquals(listOf(sta, ap), LanNetworkSelection.stationCandidates(listOf(sta, ap), 0))
+        assertThrows(LanConnectionException::class.java) { LanNetworkSelection.choose(listOf(sta, ap), null) }
+    }
+}
