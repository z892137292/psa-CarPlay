+package com.shilapi.xcertplay.media
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class PsaRomAudioGuardTest {
+    @Test fun missingRomMethodIsReportedWithoutEscapingWorkerBoundary() {
+        val failures = mutableListOf<Throwable>()
+        assertFalse(RomAudioGuard.attempt({ failures += it }) { throw NoSuchMethodError("vendor audio API") })
+        assertTrue(failures.single() is NoSuchMethodError)
+        assertTrue(RomAudioGuard.attempt({ fail("A new session must still be able to play") }) {})
+    }
+    @Test fun decoderConfigureFailureReleasesPartialDecoderAndPropagatesCause() {
+        val events = mutableListOf<String>()
+        val failure = assertThrows(IllegalStateException::class.java) {
+            RomAudioGuard.initialize<String>({ "decoder" }, { throw IllegalStateException("configure rejected") }, { events += "release:$it" })
+        }
+        assertEquals("configure rejected", failure.message)
+        assertEquals(listOf("release:decoder"), events)
+    }
+    @Test fun decoderCreationFailureDoesNotReleaseAnUncreatedResource() {
+        assertThrows(NoSuchMethodError::class.java) {
+            RomAudioGuard.initialize<String>({ throw NoSuchMethodError("createDecoder") }, { fail() }, { fail() })
+        }
+    }
+    @Test fun cleanupFailureDoesNotPreventRemainingResourceRelease() {
+        val failures = mutableListOf<Throwable>()
+        var released = false
+        assertFalse(RomAudioGuard.attempt({ failures += it }) { throw NoSuchMethodError("stop") })
+        assertTrue(RomAudioGuard.attempt({ fail() }) { released = true })
+        assertTrue(released); assertEquals(1, failures.size)
+    }
+    @Test fun uninitializedTrackCannotBeReportedReady() {
+        assertThrows(IllegalStateException::class.java) { RomAudioGuard.requireInitialized("track") { false } }
+        assertEquals("track", RomAudioGuard.requireInitialized("track") { true })
+    }
+    @Test fun missingLegacyConstructorFallsBackToPlayableUsageTrack() {
+        assertEquals("usage", LegacyAudioFallback.build<String>(
+            { throw NoSuchMethodError("legacy ctor") }, { fail(); false }, { fail() }, { "usage" }))
+    }
+    @Test fun releaseOfRejectedLegacyTrackCannotBlockFallback() {
+        assertEquals("usage", LegacyAudioFallback.build({ "legacy" }, { false },
+            { throw NoSuchMethodError("release") }, { "usage" }))
+    }
+    @Test fun fatalVmFailuresAreNotMistakenForRomCompatibilityErrors() {
+        assertThrows(OutOfMemoryError::class.java) { RomAudioGuard.attempt({ fail() }) { throw OutOfMemoryError() } }
+    }
+}
