+        val target=Destination(setOf(Settings.ACTION_WIFI_SETTINGS,Settings.ACTION_WIRELESS_SETTINGS));NetworkSettingsLauncher.wifi(target)
+        assertEquals(listOf(Settings.ACTION_WIFI_SETTINGS,Settings.ACTION_WIRELESS_SETTINGS,Settings.ACTION_SETTINGS),target.attempts.map { it.action })
+    }
