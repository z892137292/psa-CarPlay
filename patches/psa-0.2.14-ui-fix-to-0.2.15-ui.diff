@@ -0,0 +1,14 @@
+package com.shilapi.xcertplay
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CarPlayUiStateTest {
+    @Test fun setupAndStatusNeverExposeVideo() { val s=CarPlayUiState();s.reset(1);s.stage("AirPlay connected; waiting for first frame");assertFalse(s.firstFrameReceived);assertTrue(s.title.contains("等待画面")) }
+    @Test fun decoderOnlyDoesNotExposeBlackTexture() { val s=CarPlayUiState();s.reset(1);s.decoded(1);assertFalse(s.firstFrameReceived) }
+    @Test fun actualTextureUpdateAfterDecoderOpensGate() { val s=CarPlayUiState();s.reset(1);s.decoded(1);s.textureUpdated(1);assertTrue(s.firstFrameReceived) }
+    @Test fun staleFrameCannotExposeNewSession() { val s=CarPlayUiState();s.reset(2);s.decoded(1);s.textureUpdated(1);assertFalse(s.firstFrameReceived) }
+    @Test fun reattachedSessionWaitsForItsNewTexture() { val s=CarPlayUiState();s.reset(2,true);assertFalse(s.firstFrameReceived);s.textureUpdated(2);assertTrue(s.firstFrameReceived) }
+    @Test fun timeoutLeavesActionableUi() { val s=CarPlayUiState();s.reset(1);s.timeout(1);assertFalse(s.firstFrameReceived);assertNotNull(s.error) }
+    @Test fun disconnectImmediatelyClosesGate() { val s=CarPlayUiState();s.reset(1);s.decoded(1);s.textureUpdated(1);s.disconnected(1);s.surfaceDetached();s.decoded(1);s.textureUpdated(1);assertFalse(s.firstFrameReceived) }
+}
