+++ b/common/src/main/java/com/shilapi/xcertplay/BluetoothPhoneRepository.kt
@@ -0,0 +1,19 @@
+package com.shilapi.xcertplay
+
+import android.bluetooth.BluetoothManager
+import android.content.Context
+
+/** Read-only real paired devices. No discovery/pairing or bootstrap ownership is changed. */
+internal object BluetoothPhoneRepository {
+    @android.annotation.SuppressLint("MissingPermission")
+    fun read(context: Context,bound: String?,preferred: String?): List<DeviceUiState> {
+        if(android.os.Build.VERSION.SDK_INT>=31 && context.checkSelfPermission(android.Manifest.permission.BLUETOOTH_CONNECT)!=android.content.pm.PackageManager.PERMISSION_GRANTED) throw IllegalStateException("需要蓝牙设备权限")
+        val adapter=context.getSystemService(BluetoothManager::class.java)?.adapter ?: return emptyList()
+        val devices=try { adapter.bondedDevices.orEmpty().map { d ->
+            val name=d.name ?: "未命名蓝牙设备"
+            val connected=runCatching { d.javaClass.getMethod("isConnected").invoke(d) as? Boolean }.getOrNull()
+            DeviceUiState(name,d.address,name.contains("iphone",true),connected,d.address.equals(bound,true))
+        } } catch(e: SecurityException) { throw IllegalStateException("需要蓝牙设备权限",e) }
+        return devices.sortedWith(compareByDescending<DeviceUiState> { it.bound }.thenByDescending { it.connected==true }.thenByDescending { it.iphone }.thenByDescending { it.address==preferred }.thenBy { it.name })
+    }
+}
