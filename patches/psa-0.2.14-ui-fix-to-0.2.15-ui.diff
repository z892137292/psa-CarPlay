+package com.shilapi.xcertplay.orchestration
+
+/** Diagnostics only. Never changes transport/protocol or admits a phone. Generation-scoped. */
+internal class ExistingLanSuccessEvidence(private val report: (String)->Unit, private val mode: String="EXISTING_LAN", private val required: Set<String> = REQUIRED) {
+    private var generation=-1
+    private val stages=mutableSetOf<String>()
+    private var reported=false
+    @Synchronized fun begin(generation: Int) { this.generation=generation;stages.clear();reported=false }
+    @Synchronized fun mark(generation: Int,stage: String) {
+        if(this.generation!=generation) return
+        if(!stages.add(stage)) return
+        report("${mode}_PROGRESS generationId=$generation stage=$stage success=false")
+        if(!reported && stages.containsAll(required)) { reported=true;report("${mode}_SUCCESS generationId=$generation stages=${required.joinToString(",")} success=true") }
+    }
+    @Synchronized fun end(generation: Int) { if(this.generation==generation) { this.generation=-1;stages.clear() } }
+    companion object { val REQUIRED=setOf("PHONE_BOUND","NETWORK_VERIFIED","LISTENER_BOUND","START_SESSION","FIRST_TCP_EXTERNAL","AIRPLAY_SETUP","TYPE130_CREATED","IAP_TUNNEL_READY","FIRST_FRAME","WIRELESS_ACTIVE") }
+}
