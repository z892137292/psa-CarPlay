+package com.shilapi.xcertplay.orchestration
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class ExistingLanSuccessEvidenceTest {
+    @Test fun noSingleMissingStageCanCountAsSuccess() {
+        for(missing in ExistingLanSuccessEvidence.REQUIRED) {
+            val logs=mutableListOf<String>();val proof=ExistingLanSuccessEvidence(logs::add)
+            proof.begin(1)
+            (ExistingLanSuccessEvidence.REQUIRED-missing).forEach { proof.mark(1,it) }
+            assertFalse("Missing $missing",logs.any { it.startsWith("EXISTING_LAN_SUCCESS") })
+            proof.mark(1,missing)
+            assertEquals(1,logs.count { it.startsWith("EXISTING_LAN_SUCCESS") })
+            val completedLogCount=logs.size
+            ExistingLanSuccessEvidence.REQUIRED.forEach { proof.mark(1,it) }
+            assertEquals(completedLogCount,logs.size)
+        }
+    }
+    @Test fun manualHotspotRequiresItsOwnConfigurationAndApPeerEvidence() {
+        val required=ExistingLanSuccessEvidence.REQUIRED + setOf("HOTSPOT_PARAMETERS_VERIFIED","WIFI_CONFIG_SENT","PHONE_JOINED_ON_AP")
+        for(missing in required) {
+            val logs=mutableListOf<String>();val proof=ExistingLanSuccessEvidence(logs::add,"MANUAL_HOTSPOT",required)
+            proof.begin(3);(required-missing).forEach { proof.mark(3,it) }
+            assertFalse(logs.any { it.startsWith("MANUAL_HOTSPOT_SUCCESS") })
+            proof.mark(3,missing)
+            assertEquals(1,logs.count { it.startsWith("MANUAL_HOTSPOT_SUCCESS") })
+            assertFalse(logs.any { it.startsWith("EXISTING_LAN_SUCCESS") })
+        }
+    }
+    @Test fun rejectsStaleGenerationAndTerminalCallbacks() {
+        val logs=mutableListOf<String>();val proof=ExistingLanSuccessEvidence(logs::add)
+        proof.begin(1);proof.begin(2)
+        ExistingLanSuccessEvidence.REQUIRED.forEach { proof.mark(1,it) }
+        proof.end(2)
+        ExistingLanSuccessEvidence.REQUIRED.forEach { proof.mark(2,it) }
+        assertTrue(logs.isEmpty())
+    }
+}
