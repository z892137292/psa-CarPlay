+package com.shilapi.xcertplay
+
+import com.shilapi.xcertplay.network.NetworkIdentityResolver
+import org.junit.Assert.*
+import org.junit.Test
+
+class NetworkIdentityResolverTest {
+    @Test fun rejectsRedactedAndPlaceholderNames() {
+        listOf(null,""," ","<unknown ssid>","UNKNOWN","null","0x","\"<unknown ssid>\"").forEach {
+            assertNull(NetworkIdentityResolver.normalizeSsid(it))
+        }
+    }
+    @Test fun knownApEvidenceOverridesWifiTransportAndNamesAreNotEvidence() {
+        assertEquals(com.shilapi.xcertplay.network.NetworkInterfaceRole.AP,com.shilapi.xcertplay.network.classifyNetworkInterface(true,false,true))
+        assertEquals(com.shilapi.xcertplay.network.NetworkInterfaceRole.STA,com.shilapi.xcertplay.network.classifyNetworkInterface(true,false,false))
+        assertEquals(com.shilapi.xcertplay.network.NetworkInterfaceRole.UNKNOWN,com.shilapi.xcertplay.network.classifyNetworkInterface(false,false,false))
+    }
+    @Test fun removesOnlyOuterQuotes() {
+        assertEquals("Home WiFi",NetworkIdentityResolver.normalizeSsid("\"Home WiFi\""))
+        assertEquals("Home WiFi",NetworkIdentityResolver.normalizeSsid("Home WiFi"))
+        assertEquals("车机网络",NetworkIdentityResolver.normalizeSsid("\"车机网络\""))
+    }
+}
