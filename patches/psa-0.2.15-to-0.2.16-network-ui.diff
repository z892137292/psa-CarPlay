+package com.shilapi.xcertplay
+
+import android.content.Context
+import android.content.Intent
+import android.provider.Settings
+import android.util.Log
+
+internal object NetworkSettingsLauncher {
+    fun wifi(context: Context) = open(context, listOf(Settings.ACTION_WIFI_SETTINGS, Settings.ACTION_WIRELESS_SETTINGS, Settings.ACTION_SETTINGS))
+    fun hotspot(context: Context) = open(context, listOf("android.settings.TETHER_SETTINGS", "android.settings.WIFI_AP_SETTINGS", Settings.ACTION_WIRELESS_SETTINGS, Settings.ACTION_SETTINGS))
+    private fun open(context: Context, actions: List<String>) {
+        for (action in actions) {
+            val intent = Intent(action)
+            val resolved = intent.resolveActivity(context.packageManager)
+            val success = runCatching { context.startActivity(intent); true }.getOrDefault(false)
+            Log.i("PSA", "NETWORK_SETTINGS_INTENT action=$action resolvedActivity=$resolved success=$success")
+            if (success) return
+        }
+        android.widget.Toast.makeText(context,"系统设置不可用，请通过车机设置进入",android.widget.Toast.LENGTH_LONG).show()
+    }
+}
