@@ -0,0 +1,123 @@
+package com.shilapi.xcertplay.orchestration
+
+import java.util.UUID
+
+enum class ConnectionMode { AUTO, WIRELESS_AP, USB, EXISTING_LAN }
+enum class ConnectionState {
+    IDLE, WAITING_FOR_PHONE, BT_DISCOVERED, BT_CONNECTING, BT_IDENTIFIED, PHONE_BOUND,
+    SOFTAP_STARTING, SOFTAP_READY, WAITING_PHONE_WIFI, AIRPLAY_WAITING, AIRPLAY_CONNECTED,
+    IAP_TUNNEL_STARTING, IAP_TUNNEL_READY, WIRELESS_ACTIVE, USB_CONNECTING, USB_ACTIVE,
+    DISCONNECTING, WAITING_RECONNECT, FAILED,
+}
+
+/** One authenticated bootstrap; discarded at teardown, never a persistent phone lock. */
+class BoundPhoneSession(
+    val generationId: Int,
+    val bluetoothAddress: String,
+    val bluetoothDeviceName: String?,
+    val expectedTransportMode: ConnectionMode,
+    val iap2Identification: String = "accessory-identification-accepted",
+    val authenticationReady: Boolean = true,
+    val mfiReady: Boolean = true,
+    val createdAt: Long = System.nanoTime(),
+) {
+    @Volatile var transportIdentifier: String? = null
+        private set
+    @Volatile var wirelessCarPlayAvailable = false
+    @Volatile var expectedNetworkInterface: String? = null
+    @Volatile var expectedNetworkAddress: String? = null
+    @Volatile var airPlayPeerAddress: String? = null
+        private set
+    @Volatile var airPlayDeviceId: String? = null
+        private set
+    @Volatile var airPlaySessionUuid: String? = null
+        private set
+    @Volatile var tunnelReady = false
+    @Volatile var wirelessActive = false
+    @Volatile var lastActivityAt = createdAt
+        private set
+
+    @Synchronized fun transportIdentity(bluetooth: String?, usb: String?): Boolean {
+        if (!bluetooth.isNullOrBlank() && !bluetooth.equals(bluetoothAddress, true)) return false
+        if (transportIdentifier != null && usb != null && transportIdentifier != usb) return false
+        if (usb != null) transportIdentifier = usb
+        lastActivityAt = System.nanoTime()
+        return true
+    }
+
+    /** TCP is provisional. A known AP client set constrains it; later SETUP fixes ownership. */
+    @Synchronized fun acceptPeer(address: String, clients: Set<String> = emptySet()): Boolean {
+        if (!authenticationReady || !mfiReady || expectedNetworkInterface == null) return false
+        val key=addressKey(address)
+        if (clients.isNotEmpty() && clients.none { addressKey(it)==key }) return false
+        return airPlayPeerAddress == null || addressKey(airPlayPeerAddress!!)==key
+    }
+
+    private fun addressKey(address: String): String {
+        val literal=address.substringBefore('%')
+        if(!literal.matches(Regex("[0-9A-Fa-f:.]+")) || (':' !in literal && literal.count { it=='.' }!=3)) return literal
+        return runCatching { java.net.InetAddress.getByName(literal).address.joinToString(",") { (it.toInt() and 255).toString() } }.getOrDefault(literal)
+    }
+
+    @Synchronized fun acceptSetup(address: String, deviceId: String?, uuid: String?): Boolean {
+        if (!acceptPeer(address)) return false
+        // deviceID may be a Wi-Fi MAC rather than the Bluetooth MAC. Never equate these blindly.
+        if (airPlayDeviceId != null && !deviceId.isNullOrBlank() && !airPlayDeviceId.equals(deviceId, true)) return false
+        if (airPlaySessionUuid != null && !uuid.isNullOrBlank() && airPlaySessionUuid != uuid) return false
+        airPlayPeerAddress = address
+        if (!deviceId.isNullOrBlank()) airPlayDeviceId = deviceId
+        if (!uuid.isNullOrBlank()) airPlaySessionUuid = uuid
+        lastActivityAt = System.nanoTime()
+        return true
+    }
+}
+
+/** AUTO chooses an attempt, not a successful session from an ATTACHED broadcast. */
+class AutoTransportManager(val mode: ConnectionMode) {
+    var selected: ConnectionMode = if (mode == ConnectionMode.AUTO) ConnectionMode.WIRELESS_AP else mode
+        private set
+    var active = false
+        private set
+    fun begin(usbCandidate: Boolean): ConnectionMode {
+        check(!active)
+        selected = if (mode == ConnectionMode.AUTO) {
+            if (usbCandidate) ConnectionMode.USB else ConnectionMode.WIRELESS_AP
+        } else mode
+        return selected
+    }
+    fun sessionEstablished(usb: Boolean) {
+        check((selected == ConnectionMode.USB) == usb)
+        active = true
+    }
+    fun wirelessFallback(oldControllerStopped: Boolean): Boolean {
+        check(oldControllerStopped) { "Old controller still owns transport resources" }
+        if (mode != ConnectionMode.AUTO || selected != ConnectionMode.USB) return false
+        active = false
+        selected = ConnectionMode.WIRELESS_AP
+        return true
+    }
+}
+
+class ConnectionTimeline(
+    val generationId: Int,
+    private val log: (String) -> Unit,
+    private val now: () -> Long = System::nanoTime,
+) {
+    val connectionAttemptId = UUID.randomUUID().toString()
+    private val started = now()
+    private val events = mutableSetOf<String>()
+    @Volatile var state = ConnectionState.IDLE
+        private set
+    @Synchronized fun mark(event: String) {
+        if (events.add(event)) log("CONNECTION_TIMELINE connectionAttemptId=$connectionAttemptId generationId=$generationId event=$event elapsedMs=${(now()-started)/1_000_000}")
+    }
+    fun transition(next: ConnectionState) {
+        state = next
+        mark(next.name)
+    }
+    fun failure(reason: String, detail: String?) {
+        log("WIRELESS_AP_DIAG connectionAttemptId=$connectionAttemptId generationId=$generationId failureStage=$reason state=$state detail=$detail")
+        transition(ConnectionState.FAILED)
+    }
+    fun elapsedMillis() = (now()-started)/1_000_000
+}
