+package com.shilapi.xcertplay
+
+import com.shilapi.xcertplay.network.*
+import com.shilapi.xcertplay.transport.Iap2WirelessSecurity
+import java.io.IOException
+import java.net.InetAddress
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk=[28],manifest=Config.NONE)
+class SoftApLifecycleTest {
+    private class Backend(val failure: Boolean=false, val cleanupFails: Boolean=false) : SoftApBackend {
+        override val name="fake"
+        var starts=0; var stops=0
+        override fun start(request: SoftApRequest, timeoutMillis: Long): SoftApSnapshot {
+            starts++
+            if(failure) throw IOException("permission_missing")
+            return snapshot()
+        }
+        override fun snapshot()=SoftApSnapshot(LanNetworkInfo("live","secret123",Iap2WirelessSecurity.WPA_WPA2,
+            44,5220,null,"ap1",InetAddress.getByName("192.168.42.1"),"5 GHz",LanNetworkBackend.WIRELESS_AP),"system",emptySet())
+        override fun close() { stops++; if(cleanupFails) throw IOException("cleanup_failed") }
+    }
+    @Test fun constructionDoesNotStartNetwork() {
+        val backend=Backend()
+        val manager=SessionSoftApManager(RuntimeEnvironment.getApplication(),{}) { listOf(backend) }
+        assertEquals(0,backend.starts)
+        manager.close()
+        assertEquals(0,backend.stops)
+    }
+    @Test fun apiFallbackWaitsForRootCleanup() {
+        val root=Backend(failure=true); val api=Backend()
+        val manager=SessionSoftApManager(RuntimeEnvironment.getApplication(),{}) { listOf(root,api) }
+        assertEquals("ap1",manager.start(1000).interfaceName)
+        assertEquals(1,root.stops); assertEquals(1,api.starts)
+        manager.close(); assertEquals(1,api.stops)
+    }
+    @Test fun failedCleanupBlocksNextBackend() {
+        val root=Backend(failure=true,cleanupFails=true); val api=Backend()
+        val manager=SessionSoftApManager(RuntimeEnvironment.getApplication(),{}) { listOf(root,api) }
+        assertThrows(IOException::class.java) { manager.start(1000) }
+        assertEquals(0,api.starts)
+    }
+    @Test fun closedGenerationCannotRestartAp() {
+        val backend=Backend()
+        val manager=SessionSoftApManager(RuntimeEnvironment.getApplication(),{}) { listOf(backend) }
+        manager.close()
+        assertThrows(IllegalStateException::class.java) { manager.start(1000) }
+        assertEquals(0,backend.starts)
+    }
+}
