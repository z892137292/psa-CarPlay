new file mode 100644
index 0000000..d58a54d
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/CarPlayUiState.kt
@@ -0,0 +1,40 @@
+package com.shilapi.xcertplay
+
+/** Presentation gate; transport/session readiness alone never exposes the video. */
+internal class CarPlayUiState {
+    private var acceptingFrames=false
+    var generation=0; private set
+    var decoderFrame=false; private set
+    var textureFrame=false; private set
+    var error: String?=null; private set
+    var title="等待手机"; private set
+    val firstFrameReceived get()=decoderFrame && textureFrame && error==null
+    fun reset(next: Int, renderedBefore: Boolean=false) { generation=next;acceptingFrames=true;decoderFrame=renderedBefore;textureFrame=false;error=null;title="正在连接 iPhone" }
+    fun stage(message: String) { if(error==null && !firstFrameReceived) title=ConnectionUiState.friendly(message) }
+    fun decoded(current: Int) { if(current==generation && acceptingFrames) { decoderFrame=true;error=null } }
+    fun textureUpdated(current: Int) { if(current==generation && acceptingFrames && decoderFrame) { textureFrame=true;error=null;title="CarPlay 已连接" } }
+    fun surfaceDetached() { textureFrame=false;if(error==null && acceptingFrames) title="正在启动 CarPlay，等待画面…" }
+    fun timeout(current: Int) { if(current==generation && !firstFrameReceived) { error="未收到 CarPlay 画面，请重新连接";title="连接异常" } }
+    fun disconnected(current: Int) { reset(current);acceptingFrames=false;title="等待连接" }
+}
+internal object ConnectionUiState {
+    fun friendly(raw: String): String = when {
+        raw.contains("FIRST_FRAME_TIMEOUT") -> "未收到 CarPlay 画面，请重新连接"
+        raw.contains("first frame",true) -> "正在启动 CarPlay，等待画面…"
+        raw.contains("HOTSPOT_FAILED",true) || raw.contains("SOFTAP_START_FAILED",true) || raw.contains("热点不可用") -> "车机热点不可用，请开启热点或检查配置"
+        raw.contains("FIRST_TCP_TIMEOUT") -> "未收到 iPhone 的无线连接"
+        raw.contains("Failed",true) || raw.contains("error",true) || raw.contains("失败") -> "连接失败，请重试或查看诊断"
+        raw.contains("不可用") || raw.contains("未验证") || raw.contains("权限") -> "连接条件未就绪，请检查连接设置和权限"
+        raw.contains("人工重连") || raw.contains("禁止新控制器") || raw.contains("连接已暂停") -> "连接已暂停，请稍后重试或查看诊断"
+        raw.contains("热点") || raw.contains("SoftAP",true) -> "正在准备车机热点"
+        raw.contains("Bluetooth",true) || raw.contains("蓝牙") -> "正在确认 iPhone"
+        raw.contains("AirPlay",true) || raw.contains("session active",true) -> "正在启动 CarPlay，等待画面…"
+        raw.contains("LAN",true) || raw.contains("network",true) || raw.contains("无线连接") -> "正在准备无线网络"
+        raw.contains("connected",true) || raw.contains("已连接") -> "正在启动 CarPlay"
+        raw.contains("reconnect",true) || raw.contains("重新连接") -> "正在重新连接"
+        raw.contains("Waiting",true) || raw.contains("等待") -> "等待手机"
+        else -> "正在连接 iPhone"
+    }
+}
+internal data class SettingsUiState(val autoConnect: Boolean,val mode: String)
+internal data class DeviceUiState(val name: String,val address: String,val iphone: Boolean,val connected: Boolean?,val bound: Boolean=false)
