diff --git a/shared/src/main/java/com/shilapi/xcertplay/network/AndroidApiSoftApBackend.kt b/shared/src/main/java/com/shilapi/xcertplay/network/AndroidApiSoftApBackend.kt
new file mode 100644
index 0000000..7b887a6
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/network/AndroidApiSoftApBackend.kt
@@ -0,0 +1,81 @@
+package com.shilapi.xcertplay.network
+
+import android.content.Context
+import android.net.wifi.WifiManager
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import java.io.IOException
+import java.net.NetworkInterface
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/** Public reservation API. It must report real 5 GHz capability, never an invented channel. */
+class AndroidApiSoftApBackend(context: Context) : SoftApBackend {
+    override val name = "AndroidApiSoftApBackend"
+    private val reader = ExistingSystemAp(context)
+    private val wifi = context.getSystemService(WifiManager::class.java)
+    private val lock = Any()
+    @Volatile private var closed = false
+    @Volatile private var reservation: WifiManager.LocalOnlyHotspotReservation? = null
+    private var network: LanNetworkInfo? = null
+    override fun start(request: SoftApRequest, timeoutMillis: Long): SoftApSnapshot {
+        val ready = CountDownLatch(1)
+        var failure: String? = null
+        val before = interfaces()
+        val callback = object : WifiManager.LocalOnlyHotspotCallback() {
+            override fun onStarted(value: WifiManager.LocalOnlyHotspotReservation) {
+                synchronized(lock) { if (closed) value.close() else reservation = value }
+                ready.countDown()
+            }
+            override fun onFailed(reason: Int) { failure = "LOCAL_ONLY_HOTSPOT_FAILURE_$reason"; ready.countDown() }
+            override fun onStopped() { closed = true; ready.countDown() }
+        }
+        val deadline = System.nanoTime() + timeoutMillis * 1_000_000
+        try {
+            // Configurable LOHS is a privileged API on most releases. Try it reflectively;
+            // the ordinary API otherwise chooses the radio and credentials itself.
+            val method = if (Build.VERSION.SDK_INT >= 30) wifi.javaClass.methods.firstOrNull {
+                it.name == "startLocalOnlyHotspot" && it.parameterTypes.size == 3 &&
+                    it.parameterTypes[0].name == "android.net.wifi.SoftApConfiguration"
+            } else null
+            if (method != null) {
+                val builder = android.net.wifi.SoftApConfiguration.Builder().setSsid(request.ssid)
+                    .setPassphrase(request.password, android.net.wifi.SoftApConfiguration.SECURITY_TYPE_WPA2_PSK)
+                    .setBand(android.net.wifi.SoftApConfiguration.BAND_5GHZ)
+                method.invoke(wifi, builder.build(), java.util.concurrent.Executor { it.run() }, callback)
+            } else wifi.startLocalOnlyHotspot(callback, Handler(Looper.getMainLooper()))
+            if (!ready.await(timeoutMillis, TimeUnit.MILLISECONDS)) throw IOException("LOCAL_ONLY_HOTSPOT_TIMEOUT")
+            failure?.let { throw IOException(it) }
+            val r = reservation ?: throw IOException("LOCAL_ONLY_HOTSPOT_STOPPED")
+            val legacy = if (Build.VERSION.SDK_INT < 30) r.wifiConfiguration else null
+            val modern = if (Build.VERSION.SDK_INT >= 30) r.softApConfiguration else null
+            val ssid = modern?.ssid ?: legacy?.SSID?.trim('"') ?: throw IOException("SOFTAP_SSID_UNAVAILABLE")
+            val password = modern?.passphrase ?: legacy?.preSharedKey?.trim('"') ?: throw IOException("SOFTAP_PASSWORD_UNAVAILABLE")
+            val channel = modern?.channel ?: runCatching { legacy!!.javaClass.getField("apChannel").getInt(legacy) }.getOrDefault(0)
+            // A configured 5 GHz band with automatic channel is not evidence of a live channel.
+            while (!closed && System.nanoTime() < deadline) {
+                val snap = reader.snapshot("")
+                val link = snap.link?.takeIf { it.addresses.any { a -> a is java.net.Inet4Address && "${it.name}/${a.hostAddress}" !in before } }
+                if (link != null) {
+                    val frequency = snap.actualFrequency
+                    val liveChannel = frequency?.let(::wifiFrequencyMhzToChannel) ?: channel
+                    network = LanNetworkInfo(ssid,password,com.shilapi.xcertplay.transport.Iap2WirelessSecurity.WPA_WPA2,
+                        liveChannel,frequency,link.mac,link.name,link.addresses.first { it is java.net.Inet4Address },
+                        "5 GHz",LanNetworkBackend.WIRELESS_AP,link.addresses,"ap_interface","local_only_reservation")
+                    return SoftApPolicy.verify(snapshot())
+                }
+                Thread.sleep(150)
+            }
+            throw IOException("SOFTAP_INTERFACE_TIMEOUT")
+        } catch (e: Exception) { close(); throw IOException("$name: ${e.javaClass.simpleName}: ${e.cause?.javaClass?.simpleName ?: e.message}", e) }
+    }
+    override fun snapshot(): SoftApSnapshot {
+        val n = network ?: throw IOException("SOFTAP_NOT_STARTED")
+        val iface = NetworkInterface.getByName(n.interfaceName)
+        if (closed || iface?.isUp != true || n.hostAddresses.any { it !in iface.inetAddresses.toList() }) throw IOException("SOFTAP_NETWORK_LOST")
+        return SoftApSnapshot(n,"system_local_only_reservation",emptySet())
+    }
+    override fun close() = synchronized(lock) { closed=true; reservation?.close(); reservation=null; network=null }
+    private fun interfaces() = NetworkInterface.getNetworkInterfaces().toList().flatMap { i -> i.inetAddresses.toList().map { "${i.name}/${it.hostAddress}" } }.toSet()
+}
