--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/network/SoftApBackend.kt
@@ -0,0 +1,28 @@
+package com.shilapi.xcertplay.network
+
+import java.io.Closeable
+
+data class SoftApRequest(val ssid: String, val password: String, val prefer5Ghz: Boolean = true)
+data class SoftApSnapshot(
+    val network: LanNetworkInfo,
+    val dhcpState: String,
+    val clientIps: Set<String>,
+    val clientCount: Int? = null,
+)
+interface SoftApBackend : Closeable {
+    val name: String
+    fun start(request: SoftApRequest, timeoutMillis: Long): SoftApSnapshot
+    fun onSessionActive() {}
+    fun snapshot(): SoftApSnapshot
+}
+
+internal object SoftApPolicy {
+    fun verify(snapshot: SoftApSnapshot): SoftApSnapshot {
+        val n = snapshot.network
+        require(!n.interfaceName.isNullOrBlank() && !n.interfaceName.startsWith("p2p", true)) { "SOFTAP_INTERFACE_INVALID" }
+        require(n.hostAddresses.any { it is java.net.Inet4Address }) { "SOFTAP_IPV4_UNAVAILABLE" }
+        require(n.ssid.isNotBlank() && n.passphrase.length >= 8) { "SOFTAP_CREDENTIALS_UNAVAILABLE" }
+        require(n.frequencyMHz in 5160..5895 && n.frequencyMHz?.let(::wifiFrequencyMhzToChannel) == n.channel) { "SOFTAP_5GHZ_UNVERIFIED" }
+        return snapshot
+    }
+}
