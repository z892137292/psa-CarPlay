+package com.shilapi.xcertplay.orchestration
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class BoundPhoneSessionTest {
+    private fun phone(generation: Int=1) = BoundPhoneSession(generation,"01:02:03:04:05:06","iPhone",ConnectionMode.WIRELESS_AP)
+        .apply { expectedNetworkInterface="ap1"; expectedNetworkAddress="192.168.50.1" }
+    @Test fun tcpDoesNotClaimSession() {
+        val p=phone()
+        assertTrue(p.acceptPeer("192.168.50.2"))
+        assertNull(p.airPlayPeerAddress)
+        assertFalse(p.acceptPeer("192.168.50.3",setOf("192.168.50.2")))
+    }
+    @Test fun scopedIpv6PeerMatchesCompressedNeighborAddress() {
+        val p=phone()
+        assertTrue(p.acceptPeer("fe80:0:0:0:0:0:0:2%5",setOf("fe80::2")))
+        assertTrue(p.acceptSetup("fe80::2%5","device","uuid"))
+        assertTrue(p.acceptPeer("fe80:0:0:0:0:0:0:2%5"))
+        assertFalse(p.acceptPeer("fe80::3%5",setOf("fe80::2")))
+    }
+    @Test fun unboundNetworkRejectsTcp() {
+        val p=phone().apply { expectedNetworkInterface=null }
+        assertFalse(p.acceptPeer("192.168.50.2"))
+    }
+    @Test fun setupFixesOwnershipAndRejectsAnotherPhone() {
+        val p=phone()
+        assertTrue(p.acceptSetup("192.168.50.2","device1","session1"))
+        assertFalse(p.acceptSetup("192.168.50.3","device2","session2"))
+        assertFalse(p.acceptSetup("192.168.50.2","device2","session1"))
+        assertFalse(p.acceptSetup("192.168.50.2","device1","session2"))
+        assertTrue(p.acceptSetup("192.168.50.2",null,null))
+    }
+    @Test fun wifiMacNeedNotEqualBluetoothMac() {
+        assertTrue(phone().acceptSetup("192.168.50.2","06:05:04:03:02:01","session1"))
+    }
+    @Test fun transportIdentityMustMatchBootstrapAndTunnel() {
+        val p=phone()
+        assertFalse(p.transportIdentity("11:02:03:04:05:06","usb1"))
+        assertTrue(p.transportIdentity("01:02:03:04:05:06","usb1"))
+        assertFalse(p.transportIdentity(null,"usb2"))
+        assertTrue(p.transportIdentity(null,"usb1"))
+    }
+    @Test fun reconnectionCreatesNewOwnership() {
+        phone(1).acceptSetup("192.168.50.2","first","uuid")
+        val next=phone(2)
+        assertNull(next.airPlayPeerAddress)
+        assertTrue(next.acceptSetup("192.168.50.3","second","new"))
+    }
+    @Test fun autoNeverSelectsLanOrDirect() {
+        val manager=AutoTransportManager(ConnectionMode.AUTO)
+        assertEquals(ConnectionMode.WIRELESS_AP,manager.begin(false))
+        assertEquals(ConnectionMode.USB,manager.begin(true))
+        assertFalse(manager.active) // USB attached is only an attempt.
+        manager.sessionEstablished(true)
+        assertTrue(manager.active)
+    }
+    @Test fun fallbackRequiresConfirmedControllerExit() {
+        val manager=AutoTransportManager(ConnectionMode.AUTO)
+        manager.begin(true)
+        assertThrows(IllegalStateException::class.java) { manager.wirelessFallback(false) }
+        assertEquals(ConnectionMode.USB,manager.selected)
+        assertTrue(manager.wirelessFallback(true))
+        assertEquals(ConnectionMode.WIRELESS_AP,manager.selected)
+    }
+    @Test fun manualUsbNeverFallsBackToWireless() {
+        val manager=AutoTransportManager(ConnectionMode.USB)
+        manager.begin(false)
+        assertFalse(manager.wirelessFallback(true))
+    }
+    @Test fun timelineUsesOneAttemptAndDeduplicatesFirstEvents() {
+        val lines=mutableListOf<String>(); var now=0L
+        val trace=ConnectionTimeline(5,lines::add) { now }
+        trace.mark("FIRST_TCP"); now=5_000_000; trace.mark("FIRST_TCP")
+        trace.failure("MFI_FAILED","rejected")
+        assertEquals(1,lines.count { it.contains("event=FIRST_TCP") })
+        assertTrue(lines.all { it.contains("generationId=5") && it.contains(trace.connectionAttemptId) })
+        assertEquals(ConnectionState.FAILED,trace.state)
+    }
+}
