@@ -0,0 +1,40 @@
+package com.shilapi.xcertplay.network
+
+import android.content.Context
+import java.io.IOException
+import java.util.UUID
+
+/** Owns only the AP of this generation; no Wi-Fi Direct fallback. */
+class SessionSoftApManager(private val context: Context, private val log: (String) -> Unit) : LanNetworkManager {
+    @Volatile private var closed = false
+    private var backend: SoftApBackend? = null
+    @Volatile var live: SoftApSnapshot? = null
+        private set
+    override fun start(timeoutMillis: Long): LanNetworkInfo {
+        check(!closed)
+        val request = SoftApRequest("PSA-CarPlay-${UUID.randomUUID().toString().take(6)}",UUID.randomUUID().toString().replace("-", "").take(16))
+        val deadline = System.nanoTime()+timeoutMillis*1_000_000
+        val failures = mutableListOf<String>()
+        for (candidate in listOf(RootSoftApBackend(context),AndroidApiSoftApBackend(context))) {
+            if(closed) throw IOException("SOFTAP_CANCELLED")
+            backend=candidate
+            try {
+                val remaining=(deadline-System.nanoTime())/1_000_000
+                if(remaining<=0) throw IOException("SOFTAP_START_TIMEOUT")
+                live=candidate.start(request,remaining)
+                log("WIRELESS_AP_DIAG softApBackend=${candidate.name} softApState=READY configuration=live")
+                return live!!.network
+            } catch(e: Exception) {
+                val reason="${candidate.name}:${e.message}"
+                failures.add(reason); log("WIRELESS_AP_DIAG softApBackend=${candidate.name} capabilityFailure=$reason")
+                // Failed cleanup must block the next backend/controller, just like normal teardown.
+                candidate.close()
+                backend=null
+            }
+        }
+        throw IOException("SOFTAP_START_FAILED ${failures.joinToString("; ")}")
+    }
+    override fun validateReady() { live=backend?.snapshot() ?: throw IOException("SOFTAP_NETWORK_LOST") }
+    override fun connectionDiagnosticSnapshot() = "softApBackend=${backend?.name} state=${if(closed) "CLOSED" else "READY"} dhcp=${live?.dhcpState} clients=${live?.clientCount ?: "unknown"} clientIps=${live?.clientIps}"
+    override fun close() { closed=true; backend?.close(); backend=null; live=null }
+}
diff --git a/shared/src/main/java/com/shilapi/xcertplay/network/SoftApBackend.kt b/shared/src/main/java/com/shilapi/xcertplay/network/SoftApBackend.kt
