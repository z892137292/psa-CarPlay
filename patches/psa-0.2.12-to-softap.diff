@@ -0,0 +1,56 @@
+package com.shilapi.xcertplay
+
+import android.view.View
+import android.widget.TextView
+import com.shilapi.xcertplay.orchestration.ConnectionMode
+import java.util.concurrent.ExecutorService
+import java.util.concurrent.atomic.AtomicBoolean
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+
+@RunWith(org.robolectric.RobolectricTestRunner::class)
+@Config(sdk = [28])
+@LooperMode(LooperMode.Mode.PAUSED)
+class CarPlayHostStartupTest {
+    @Test fun usbLaunchCreatesOriginalPreparationThroughRealLifecycle() = launch(ConnectionMode.USB)
+    @Test fun wirelessLaunchCreatesOriginalPreparationThroughRealLifecycle() = launch(ConnectionMode.WIRELESS_AP)
+
+    private fun launch(mode: ConnectionMode) {
+        val app=RuntimeEnvironment.getApplication()
+        AirPlayPersistence.saveConnectionMode(app,mode)
+        // Authentication material and physical transports are outside this UI test.
+        // Only bootstrap provisioning is bypassed; onCreate and the view are not.
+        val ready=DiPlayBootstrap::class.java.getDeclaredField("ready").apply { isAccessible=true }
+        val oldReady=ready.getBoolean(null)
+        ready.setBoolean(null,true)
+        val lifecycle=Robolectric.buildActivity(CarPlayHostActivity::class.java)
+        val activity=lifecycle.get()
+        fun field(name: String)=CarPlayHostActivity::class.java.getDeclaredField(name).apply { isAccessible=true }
+        field("awaitingVpnConsent").setBoolean(activity,true)
+        try {
+            lifecycle.create().start().resume().visible()
+            assertFalse("Startup must not immediately finish",activity.isFinishing)
+            val panel=field("connectionPanel").get(activity) as? View
+            assertNotNull("onCreate must install the original preparation panel",panel)
+            assertTrue("Preparation must be visible in the actual window",panel!!.isShown)
+            assertEquals(View.VISIBLE,panel.visibility)
+            assertNotNull(field("videoView").get(activity))
+            assertNotNull(field("airPlayIdentity").get(activity))
+            assertNotNull(field("sessionLog").get(activity))
+            assertTrue((field("stageStatusView").get(activity) as TextView).text.isNotBlank())
+            assertEquals(mode==ConnectionMode.WIRELESS_AP,field("wirelessEnabled").getBoolean(activity))
+        } finally {
+            (field("shuttingDown").get(activity) as AtomicBoolean).set(true)
+            (field("teardownExecutor").get(activity) as ExecutorService).shutdownNow()
+            (field("airPlayCommandExecutor").get(activity) as ExecutorService).shutdownNow()
+            lifecycle.pause().stop().destroy()
+            ready.setBoolean(null,oldReady)
+            CarPlayBackgroundSession.clear()
+        }
+    }
+}
