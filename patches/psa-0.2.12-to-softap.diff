@@ -0,0 +1,63 @@
+package com.shilapi.xcertplay.network
+
+import android.Manifest
+import android.content.Context
+import android.content.pm.PackageManager
+import android.location.LocationManager
+import android.net.ConnectivityManager
+import android.net.Network
+import android.net.NetworkCapabilities
+import android.net.wifi.WifiInfo
+import android.net.wifi.WifiManager
+import android.os.Build
+
+enum class NetworkInterfaceRole { STA, AP, P2P, USB_NCM, TUN, UNKNOWN }
+
+/** Role derives from OS transport/tethering evidence; a wlan name alone has no role. */
+fun classifyNetworkInterface(wifiStation: Boolean, vpn: Boolean, tethered: Boolean,
+    verifiedP2p: Boolean=false, verifiedUsbNcm: Boolean=false): NetworkInterfaceRole = when {
+    vpn -> NetworkInterfaceRole.TUN
+    verifiedUsbNcm -> NetworkInterfaceRole.USB_NCM
+    verifiedP2p -> NetworkInterfaceRole.P2P
+    tethered -> NetworkInterfaceRole.AP
+    wifiStation -> NetworkInterfaceRole.STA
+    else -> NetworkInterfaceRole.UNKNOWN
+}
+
+/** Read-only identity of an OS Wi-Fi station Network; never uses AP configuration as STA identity. */
+class NetworkIdentityResolver(private val context: Context) {
+    data class Identity(val network: Network?, val interfaceName: String?, val info: WifiInfo?,
+        val rawSsid: String?, val ssid: String?, val reason: String, val locationEnabled: Boolean,
+        val finePermission: Boolean, val coarsePermission: Boolean, val nearbyPermission: Boolean) {
+        fun diagnostic() = "role=${if(network!=null && interfaceName!=null) NetworkInterfaceRole.STA else NetworkInterfaceRole.UNKNOWN} staInterface=$interfaceName staSsidRaw=$rawSsid staSsidNormalized=$ssid staBssid=${info?.bssid} staFrequency=${info?.frequency} staRssi=${info?.rssi} linkSpeed=${info?.linkSpeed} networkId=${info?.networkId} ssidPermission=$finePermission coarsePermission=$coarsePermission locationEnabled=$locationEnabled nearbyWifiPermission=$nearbyPermission ssidStatus=$reason"
+    }
+    fun resolve(network: Network? = null): Identity {
+        val cm=context.getSystemService(ConnectivityManager::class.java)
+        fun station(n: Network)=cm?.getNetworkCapabilities(n)?.let { it.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) && !it.hasTransport(NetworkCapabilities.TRANSPORT_VPN) }==true
+        val candidates=cm?.allNetworks.orEmpty().filter(::station)
+        val physicalLinks=candidates.mapNotNull { cm?.getLinkProperties(it)?.interfaceName }.distinct()
+        val chosen=network ?: cm?.activeNetwork?.takeIf(::station) ?: candidates.firstOrNull().takeIf { physicalLinks.size==1 }
+        val caps=chosen?.let { cm?.getNetworkCapabilities(it) }
+        val station=caps?.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)==true && !caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)
+        val name=if(station) chosen?.let { cm?.getLinkProperties(it)?.interfaceName } else null
+        fun granted(p: String)=context.checkSelfPermission(p)==PackageManager.PERMISSION_GRANTED
+        val fine=granted(Manifest.permission.ACCESS_FINE_LOCATION)
+        val coarse=granted(Manifest.permission.ACCESS_COARSE_LOCATION)
+        val nearby=Build.VERSION.SDK_INT<33 || granted(Manifest.permission.NEARBY_WIFI_DEVICES)
+        val location=runCatching { context.getSystemService(LocationManager::class.java)?.isLocationEnabled==true }.getOrDefault(false)
+        val modern=if(station && Build.VERSION.SDK_INT>=29) caps?.transportInfo as? WifiInfo else null
+        @Suppress("DEPRECATION")
+        val legacy=if(station && (modern==null || normalizeSsid(modern.ssid)==null)) runCatching { context.getSystemService(WifiManager::class.java)?.connectionInfo }.getOrNull() else null
+        // Legacy has process-wide scope: use only when a single physical STA link is visible.
+        val links=cm?.allNetworks.orEmpty().filter { cm?.getNetworkCapabilities(it)?.let { caps -> caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) && !caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN) }==true }.mapNotNull { cm?.getLinkProperties(it)?.interfaceName }.distinct()
+        val info=modern?.takeIf { normalizeSsid(it.ssid)!=null } ?: legacy?.takeIf { links.size==1 && it.networkId>=0 } ?: modern
+        val raw=runCatching { info?.ssid }.getOrNull()
+        val permission=if(Build.VERSION.SDK_INT>=29) fine else fine || coarse
+        val ssid=if(permission && location) normalizeSsid(raw) else null
+        val reason=when { !station -> "STA_NETWORK_UNAVAILABLE"; !permission -> "SSID_PERMISSION_DENIED"; !location -> "SSID_LOCATION_DISABLED"; ssid==null -> "SSID_UNAVAILABLE"; else -> "SSID_CONFIRMED" }
+        return Identity(chosen,name,info,raw,ssid,reason,location,fine,coarse,nearby)
+    }
+    companion object {
+        fun normalizeSsid(raw: String?): String? = raw?.trim()?.removeSurrounding("\"")?.trim()?.takeUnless { it.isEmpty() || it.lowercase() in setOf("<unknown ssid>","unknown","null","0x") }
+    }
+}
