@@ -0,0 +1,43 @@
+package com.shilapi.xcertplay
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.view.Gravity
+import android.view.View
+import android.widget.*
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** Shared Android View shell; no network work, demo devices or branded artwork. */
+internal object CarPlayShell {
+    val background=Color.rgb(10,14,21)
+    val cardColor=Color.rgb(28,34,44)
+    val text=Color.rgb(241,244,250)
+    val muted=Color.rgb(167,177,193)
+    fun dp(c: Context,n: Int)=(n*c.resources.displayMetrics.density).toInt()
+    fun column(c: Context)=LinearLayout(c).apply { orientation=LinearLayout.VERTICAL }
+    fun label(c: Context,s: String,size: Float=20f)=TextView(c).apply { text=s;textSize=size;setTextColor(CarPlayShell.text);typeface=Typeface.create("sans-serif",Typeface.NORMAL);setPadding(0,dp(c,8),0,dp(c,8)) }
+    fun shape(c: Context,color: Int)=GradientDrawable().apply { setColor(color);cornerRadius=dp(c,24).toFloat() }
+    fun card(c: Context)=column(c).apply { background=shape(c,cardColor);setPadding(dp(c,28),dp(c,22),dp(c,28),dp(c,22));elevation=dp(c,2).toFloat() }
+    fun button(c: Context,s: String,action: ()->Unit)=Button(c).apply { text=s;isAllCaps=false;textSize=19f;setTextColor(CarPlayShell.text);background=shape(c,Color.rgb(47,59,76));minHeight=dp(c,60);setPadding(dp(c,22),dp(c,12),dp(c,22),dp(c,12));setOnClickListener { action() } }
+    fun layout(c: Context,page: String,onNavigate: (String)->Unit,body: LinearLayout): View {
+        val root=column(c).apply { setBackgroundColor(CarPlayShell.background);setPadding(dp(c,24),dp(c,12),dp(c,24),dp(c,16)) }
+        val header=LinearLayout(c).apply { gravity=Gravity.CENTER_VERTICAL }
+        header.addView(label(c,"PSA CarPlay",32f),LinearLayout.LayoutParams(0,dp(c,64),1f))
+        header.addView(label(c,SimpleDateFormat("HH:mm",Locale.getDefault()).format(Date()),22f))
+        root.addView(header)
+        val row=LinearLayout(c)
+        val compact=c.resources.configuration.screenHeightDp<500
+        val nav=column(c).apply { setPadding(0,dp(c,14),dp(c,22),0) }
+        listOf("home" to "CarPlay","phones" to "手机","connection" to "连接","settings" to "设置","diagnostics" to "诊断").forEach { (key,name)->
+            nav.addView(button(c,name) { onNavigate(key) }.apply { if(page==key) background=shape(c,Color.rgb(64,82,108)) },LinearLayout.LayoutParams(-1,dp(c,if(compact) 48 else 64)).apply { bottomMargin=dp(c,if(compact) 6 else 14) })
+        }
+        row.addView(nav,LinearLayout.LayoutParams(dp(c,if(c.resources.configuration.screenWidthDp<900) 120 else 256),-1))
+        val scroll=ScrollView(c).apply { isFillViewport=true;clipToPadding=false;setPadding(dp(c,18),dp(c,14),dp(c,12),dp(c,12));addView(body) }
+        row.addView(scroll,LinearLayout.LayoutParams(0,-1,1f))
+        root.addView(row,LinearLayout.LayoutParams(-1,0,1f));return root
+    }
+}
