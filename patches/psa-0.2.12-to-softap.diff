+@LooperMode(LooperMode.Mode.PAUSED)
+class CarPlayShellStartupTest {
+    @Test fun coldLaunchShowsRealNavigationBeforePhoneExists() {
+        DiPlayPreferences.saveAutoConnect(RuntimeEnvironment.getApplication(),false)
+        val ready=DiPlayBootstrap::class.java.getDeclaredField("ready").apply { isAccessible=true };val old=ready.getBoolean(null);ready.setBoolean(null,true)
+        val lifecycle=Robolectric.buildActivity(DiPlayActivity::class.java)
+        try {
+            lifecycle.create().start().resume().visible()
+            val root=lifecycle.get().findViewById<ViewGroup>(android.R.id.content)
