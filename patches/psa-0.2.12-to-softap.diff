@@ -0,0 +1,20 @@
+package com.shilapi.xcertplay.network
+
+import com.shilapi.xcertplay.transport.Iap2WirelessSecurity
+import java.net.InetAddress
+import org.junit.Assert.*
+import org.junit.Test
+
+class SoftApPolicyTest {
+    private fun snapshot(iface: String="ap1",channel: Int=36,address: String="192.168.9.1") = SoftApSnapshot(
+        LanNetworkInfo("test","secret123",Iap2WirelessSecurity.WPA_WPA2,channel,null,null,iface,
+            InetAddress.getByName(address),"5 GHz",LanNetworkBackend.WIRELESS_AP),"system",emptySet())
+    @Test fun actualSystemSubnetIsAccepted() { assertEquals("192.168.9.1",SoftApPolicy.verify(snapshot()).network.hostAddress!!.hostAddress) }
+    @Test fun stationAndDirectCannotBeInventedAsAp() { assertThrows(IllegalArgumentException::class.java) { SoftApPolicy.verify(snapshot("p2p0")) } }
+    @Test fun unknownAndTwoPointFourChannelFailExplicitly() {
+        assertThrows(IllegalArgumentException::class.java) { SoftApPolicy.verify(snapshot(channel=0)) }
+        assertThrows(IllegalArgumentException::class.java) { SoftApPolicy.verify(snapshot(channel=6)) }
+    }
+    @Test fun noIpv4FailsRatherThanAdvertisingWrongIpv6() { assertThrows(IllegalArgumentException::class.java) { SoftApPolicy.verify(snapshot(address="fe80::1")) } }
+    @Test fun shellArgumentsAreQuoted() { assertEquals("'a'\\''b'",SoftApRootShell.quote("a'b")) }
+}
