--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/network/RootSoftApBackend.kt
@@ -0,0 +1,125 @@
+package com.shilapi.xcertplay.network
+
+import android.content.Context
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+
+/** No reusable su executor exists in this PSA baseline; all new calls are bounded and quoted. */
+internal class SoftApRootShell {
+    fun run(command: String, timeoutMillis: Long = 8_000): String {
+        val process = ProcessBuilder("su", "-c", command).redirectErrorStream(true).start()
+        val output = StringBuilder()
+        val reader = Thread {
+            try { process.inputStream.bufferedReader().use { input ->
+                input.forEachLine { synchronized(output) { if (output.length < 131072) output.append(it).append('\n') } }
+            } } catch (_: IOException) { /* command cancellation closes this pipe */ }
+        }.apply { isDaemon = true; start() }
+        try {
+            if (!process.waitFor(timeoutMillis, TimeUnit.MILLISECONDS)) throw IOException("ROOT_COMMAND_TIMEOUT")
+            reader.join(1_000)
+            if (process.exitValue() != 0) throw IOException("ROOT_COMMAND_EXIT_${process.exitValue()}")
+            return synchronized(output) { output.toString() }
+        } finally {
+            process.destroy()
+            process.inputStream.close()
+        }
+    }
+    companion object { fun quote(value: String) = "'" + value.replace("'", "'\\''") + "'" }
+}
+
+class RootSoftApBackend(private val context: Context) : SoftApBackend {
+    override val name = "RootSoftApBackend"
+    private val shell = SoftApRootShell()
+    @Volatile private var closed = false
+    @Volatile private var owned = false
+    private var request: SoftApRequest? = null
+    private var attached: LanNetworkInfo? = null
+    private var cached: SoftApSnapshot? = null
+    private var sampledAt=0L
+    @Volatile private var sampleIntervalNanos=2_000_000_000L
+    override fun onSessionActive() { sampleIntervalNanos=10_000_000_000L }
+    private fun command(action: String, args: List<String> = emptyList()): String {
+        val root = shell.run("id -u").trim()
+        if (root != "0") throw IOException("ROOT_UNAVAILABLE uid=$root")
+        val cmd = "PSA_SOFTAP_APK=${SoftApRootShell.quote(context.applicationInfo.sourceDir)} " +
+            "PSA_SOFTAP_NATIVE_DIR=${SoftApRootShell.quote(context.applicationInfo.nativeLibraryDir)} CLASSPATH=${SoftApRootShell.quote(context.applicationInfo.sourceDir)} app_process /system/bin " +
+            "com.shilapi.xcertplay.network.RootSoftApMain " + (listOf(action) + args).joinToString(" ") { SoftApRootShell.quote(it) }
+        return shell.run(cmd)
+    }
+    private fun rejected(action: String, output: String): IOException {
+        val detail=output.lineSequence().firstOrNull { it.startsWith("SOFTAP_JSON=") }?.let {
+            runCatching { JSONObject(it.substringAfter('=')).optString("error","PLATFORM_REJECTED") }.getOrDefault("INVALID_RESPONSE")
+        } ?: "NO_PLATFORM_RESPONSE"
+        return IOException("ROOT_SOFTAP_${action}_REJECTED:$detail")
+    }
+    private fun read(): JSONObject {
+        val result = command("snapshot").lineSequence().firstOrNull { it.startsWith("SOFTAP_JSON=") }
+            ?: throw IOException("ROOT_SOFTAP_SNAPSHOT_UNAVAILABLE")
+        val json = JSONObject(result.substringAfter('='))
+        if (json.has("error")) throw IOException("ROOT_SOFTAP_${json.getString("error")}")
+        return json
+    }
+    override fun start(request: SoftApRequest, timeoutMillis: Long): SoftApSnapshot {
+        this.request = request
+        val initial = read()
+        if (initial.optBoolean("enabled")) throw IOException("SOFTAP_ALREADY_RUNNING_NOT_OWNED")
+        // Claim cleanup responsibility before a partially successful platform start.
+        owned = true
+        val result = command("start",listOf(request.ssid,request.password))
+        if (!result.contains("SOFTAP_START_ACCEPTED")) throw rejected("START",result)
+        val deadline = System.nanoTime() + timeoutMillis * 1_000_000
+        while (!closed && System.nanoTime() < deadline) {
+            val json = read()
+            if (json.optBoolean("enabled") && json.optJSONArray("interfaces")?.length() == 1) {
+                try { return SoftApPolicy.verify(parse(json)).also { attached=it.network; cached=it; sampledAt=System.nanoTime() } }
+                catch(e: IllegalArgumentException) { if(e.message!="SOFTAP_5GHZ_UNVERIFIED") throw e }
+            }
+            Thread.sleep(200)
+        }
+        throw IOException("ROOT_SOFTAP_READY_TIMEOUT")
+    }
+    private fun parse(json: JSONObject): SoftApSnapshot {
+        val target = request ?: throw IOException("SOFTAP_NOT_REQUESTED")
+        if (json.optString("ssid") != target.ssid || json.optString("password") != target.password) throw IOException("SOFTAP_CONFIGURATION_MISMATCH")
+        val interfaces = json.getJSONArray("interfaces")
+        if (interfaces.length() != 1) throw IOException("SOFTAP_INTERFACE_AMBIGUOUS")
+        val link = interfaces.getJSONObject(0)
+        val iface = java.net.NetworkInterface.getByName(link.getString("name")) ?: throw IOException("SOFTAP_INTERFACE_MISSING")
+        val addresses = existingWifiHostAddresses(iface.inetAddresses.toList(),iface.index)
+        val v4 = addresses.filterIsInstance<java.net.Inet4Address>().firstOrNull() ?: throw IOException("SOFTAP_IPV4_UNAVAILABLE")
+        val channel = json.optInt("channel")
+        val frequency = json.optInt("frequency").takeIf { it > 0 } ?: LegacyHotspotRadio.read(iface.name,json.optString("band")).frequencyMHz
+        val n = LanNetworkInfo(target.ssid,target.password,com.shilapi.xcertplay.transport.Iap2WirelessSecurity.WPA_WPA2,
+            frequency?.let(::wifiFrequencyMhzToChannel) ?: channel,frequency,AccessPointIdentity.valid(link.optString("mac")),
+            iface.name,v4,"5 GHz",LanNetworkBackend.WIRELESS_AP,addresses,"ap_interface","root_live_configuration")
+        val ips = json.optJSONArray("clients")?.let { a -> (0 until a.length()).map { a.getString(it) }.toSet() }.orEmpty()
+        return SoftApSnapshot(n,json.optString("dhcp","unknown"),ips,json.optInt("clientCount",-1).takeIf { it >= 0 })
+    }
+    override fun snapshot(): SoftApSnapshot {
+        val old=attached ?: throw IOException("SOFTAP_NOT_STARTED")
+        val iface=java.net.NetworkInterface.getByName(old.interfaceName)
+        if(closed || iface?.isUp!=true || old.hostAddresses.any { it !in iface.inetAddresses.toList() }) throw IOException("SOFTAP_NETWORK_LOST")
+        val measured=LegacyHotspotRadio.read(iface.name,"5 GHz").frequencyMHz
+        if(measured!=null && measured!=old.frequencyMHz) throw IOException("SOFTAP_RADIO_CHANGED")
+        if(System.nanoTime()-sampledAt<sampleIntervalNanos) cached?.let { return it }
+        val json=read()
+        if(!json.optBoolean("enabled")) throw IOException("SOFTAP_NETWORK_LOST")
+        val result = SoftApPolicy.verify(parse(json))
+        attached?.let { old -> if (old.interfaceName != result.network.interfaceName || old.hostAddresses.toSet() != result.network.hostAddresses.toSet() || old.frequencyMHz != result.network.frequencyMHz || old.bssid != result.network.bssid) throw IOException("SOFTAP_INTERFACE_CHANGED") }
+        return result.also { cached=it; sampledAt=System.nanoTime() }
+    }
+    override fun close() {
+        closed = true
+        if (owned) {
+            val result = command("stop")
+            if (!result.contains("SOFTAP_STOP_ACCEPTED")) throw rejected("STOP",result)
+            val deadline = System.nanoTime() + 5_000_000_000L
+            while (read().optBoolean("enabled")) {
+                if (System.nanoTime() >= deadline) throw IOException("ROOT_SOFTAP_STOP_TIMEOUT")
+                Thread.sleep(100)
+            }
+            owned = false
+        }
+    }
+}
diff --git a/shared/src/main/java/com/shilapi/xcertplay/network/RootSoftApMain.kt b/shared/src/main/java/com/shilapi/xcertplay/network/RootSoftApMain.kt
new file mode 100644
index 0000000..0a1b53b
--- /dev/null
+++ b/shared/src/main/java/com/shilapi/xcertplay/network/RootSoftApMain.kt
@@ -0,0 +1,163 @@
+package com.shilapi.xcertplay.network
+
+import android.content.Context
+import android.net.ConnectivityManager
+import android.net.wifi.WifiConfiguration
+import android.net.wifi.WifiManager
+import android.os.Build
+import android.os.Looper
+import android.os.ResultReceiver
+import org.json.JSONArray
+import org.json.JSONObject
+import java.lang.reflect.Proxy
+import java.net.NetworkInterface
+import java.util.concurrent.Executor
+import java.util.concurrent.TimeUnit
+
+/** APK entry point executed as uid 0 by app_process; no Binder transaction numbers. */
+object RootSoftApMain {
+    // This entry point runs as uid 0 in system app_process, not under the application hidden-API policy.
+    @android.annotation.SuppressLint("SoonBlockedPrivateApi")
+    @JvmStatic fun main(args: Array<String>) {
+        try {
+            System.getenv("PSA_SOFTAP_APK")?.let { System.setProperty("psa.softap.root.apk",it) }
+            System.getenv("PSA_SOFTAP_NATIVE_DIR")?.let { System.setProperty("psa.softap.root.nativeDir",it) }
+            if (Looper.myLooper() == null) Looper.prepareMainLooper()
+            val activityThread = Class.forName("android.app.ActivityThread")
+            val thread = activityThread.getMethod("systemMain").invoke(null)
+            val context = activityThread.getMethod("getSystemContext").invoke(thread) as Context
+            val wifi = context.getSystemService(WifiManager::class.java)
+            val cm = context.getSystemService(ConnectivityManager::class.java)
+            when (args.firstOrNull()) {
+                "start" -> {
+                    require(args.size == 3)
+                    if (Build.VERSION.SDK_INT >= 30) {
+                        val builder=Class.forName("android.net.wifi.SoftApConfiguration\$Builder").getConstructor().newInstance()
+                        call(builder,"setSsid",args[1])
+                        call(builder,"setPassphrase",args[2],android.net.wifi.SoftApConfiguration.SECURITY_TYPE_WPA2_PSK)
+                        call(builder,"setBand",android.net.wifi.SoftApConfiguration.BAND_5GHZ)
+                        val config=call(builder,"build")!!
+                        check(call(wifi,"setSoftApConfiguration",config) != false) { "CONFIGURATION_REJECTED" }
+                    } else {
+                        val config = WifiConfiguration().apply {
+                            SSID=args[1]; preSharedKey=args[2]
+                            allowedKeyManagement.set(4) // legacy WPA2_PSK, not station WPA_PSK
+                            javaClass.getField("apBand").setInt(this,1) // Android legacy 5 GHz
+                            javaClass.getField("apChannel").setInt(this,0) // regulatory ACS
+                        }
+                        check(call(wifi,"setWifiApConfiguration",config) != false) { "CONFIGURATION_REJECTED" }
+                    }
+                    val ready=java.util.concurrent.CountDownLatch(1)
+                    val response=java.util.concurrent.atomic.AtomicInteger(-1)
+                    if(Build.VERSION.SDK_INT>=30) {
+                        val manager=context.getSystemService("tethering") ?: error("TETHERING_SERVICE_MISSING")
+                        val builder=Class.forName("android.net.TetheringManager\$TetheringRequest\$Builder").getConstructor(Int::class.javaPrimitiveType).newInstance(0)
+                        val request=call(builder,"build")!!
+                        val type=Class.forName("android.net.TetheringManager\$StartTetheringCallback")
+                        check(type.isInterface) { "TETHERING_CALLBACK_UNSUPPORTED" }
+                        val cb=Proxy.newProxyInstance(type.classLoader,arrayOf(type)) { self,m,a ->
+                            when(m.name) {
+                                "hashCode" -> System.identityHashCode(self)
+                                "equals" -> self === a?.firstOrNull()
+                                "onTetheringStarted" -> { response.set(0); ready.countDown(); null }
+                                "onTetheringFailed" -> { response.set((a?.firstOrNull() as Number).toInt()); ready.countDown(); null }
+                                else -> null
+                            }
+                        }
+                        call(manager,"startTethering",request,Executor { it.run() },cb)
+                    } else {
+                        val service = ConnectivityManager::class.java.getDeclaredField("mService").apply { isAccessible=true }.get(cm)
+                        service.javaClass.getMethod("startTethering",Int::class.javaPrimitiveType,ResultReceiver::class.java,Boolean::class.javaPrimitiveType,String::class.java)
+                            .invoke(service,0,object : ResultReceiver(null) {
+                                override fun onReceiveResult(code: Int,data: android.os.Bundle?) { response.set(code); ready.countDown() }
+                            },false,context.packageName)
+                    }
+                    if(!ready.await(4,TimeUnit.SECONDS)) throw java.io.IOException("TETHER_CALLBACK_TIMEOUT")
+                    if(response.get()!=0) throw java.io.IOException("TETHER_ERROR_${response.get()}")
+                    println("SOFTAP_START_ACCEPTED")
+                }
+                "stop" -> { call(if(Build.VERSION.SDK_INT>=30) context.getSystemService("tethering")!! else cm,"stopTethering",0); println("SOFTAP_STOP_ACCEPTED") }
+                "snapshot" -> snapshot(context,wifi,cm)
+                else -> error("INVALID_ACTION")
+            }
+        } catch (e: Throwable) {
+            // Credentials are never echoed, including invocation exceptions.
+            println("SOFTAP_JSON=" + JSONObject().put("error",if(e is java.io.IOException) e.message else (e.cause ?: e).let { cause -> cause.javaClass.simpleName +
+                if(cause is NoSuchMethodException) ":${cause.message}" else "" }))
+        }
+        kotlin.system.exitProcess(0)
+    }
+    private fun call(target: Any, name: String, vararg args: Any): Any? {
+        val m = target.javaClass.methods.firstOrNull { it.name == name && it.parameterTypes.size == args.size && it.parameterTypes.zip(args).all { (type,arg) ->
+            type.isInstance(arg) || (type==Int::class.javaPrimitiveType && arg is Int) ||
+                (type==Boolean::class.javaPrimitiveType && arg is Boolean)
+        } }
+            ?: throw NoSuchMethodException(name)
+        return m.invoke(target,*args)
+    }
+    private fun snapshot(context: Context,wifi: WifiManager, cm: ConnectivityManager) {
+        val enabled = call(wifi,"isWifiApEnabled") == true
+        val out = JSONObject().put("enabled",enabled)
+        if (enabled) {
+            val c = if (Build.VERSION.SDK_INT >= 30) call(wifi,"getSoftApConfiguration")!! else call(wifi,"getWifiApConfiguration")!!
+            out.put("ssid", if(c is WifiConfiguration) c.SSID.trim('"') else call(c,"getSsid"))
+            out.put("password", if(c is WifiConfiguration) c.preSharedKey?.trim('"') else call(c,"getPassphrase"))
+            out.put("band",if(c is WifiConfiguration) { if(c.javaClass.getField("apBand").getInt(c)==1) "5 GHz" else "2.4 GHz" } else if((call(c,"getBand") as Number).toInt()==2) "5 GHz" else "unknown")
+            // Report only a live radio frequency. Configured channel/ACS is separate evidence.
+            out.put("configuredChannel",if(c is WifiConfiguration) c.javaClass.getField("apChannel").getInt(c) else call(c,"getChannel"))
+            val observedFrequency=java.util.concurrent.atomic.AtomicInteger()
+            val observedClients=java.util.concurrent.atomic.AtomicInteger(-1)
+            runCatching {
+                val type = Class.forName("android.net.wifi.WifiManager\$SoftApCallback")
+                val observer = Proxy.newProxyInstance(type.classLoader,arrayOf(type)) { self,m,a ->
+                    when(m.name) {
+                        "hashCode" -> System.identityHashCode(self)
+                        "equals" -> self === a?.firstOrNull()
+                        "onInfoChanged" -> {
+                            val infos = (a?.firstOrNull() as? List<*>) ?: listOfNotNull(a?.firstOrNull())
+                            if(infos.size==1) observedFrequency.set((call(infos.single()!!,"getFrequency") as Number).toInt())
+                            null
+                        }
+                        "onConnectedClientsChanged" -> { observedClients.set((a?.lastOrNull() as? List<*>)?.size ?: -1); null }
+                        "onNumClientsChanged" -> { observedClients.set((a?.firstOrNull() as? Number)?.toInt() ?: -1); null }
+                        else -> null
+                    }
+                }
+                val add=wifi.javaClass.methods.first { it.name=="registerSoftApCallback" && it.parameterTypes.size==2 }
+                val callbackThread=android.os.HandlerThread("root-softap-info").apply { start() }
+                try {
+                    if(add.parameterTypes.first()==Executor::class.java) add.invoke(wifi,Executor { it.run() },observer)
+                    else add.invoke(wifi,observer,android.os.Handler(callbackThread.looper))
+                    Thread.sleep(200)
+                    wifi.javaClass.getMethod("unregisterSoftApCallback",type).invoke(wifi,observer)
+                } finally { callbackThread.quitSafely() }
+            }
+            var frequency=observedFrequency.get()
+            val clients=observedClients.get().takeIf { it>=0 }
+            val tethered = (call(if(Build.VERSION.SDK_INT>=30) context.getSystemService("tethering")!! else cm,"getTetheredIfaces") as Array<*>).filterIsInstance<String>()
+            val links = JSONArray()
+            val ips = mutableSetOf<String>()
+            for(name in tethered) {
+                if(name.startsWith("p2p",true)) continue
+                val i = NetworkInterface.getByName(name) ?: continue
+                if(!i.isUp || i.inetAddresses.toList().none { it is java.net.Inet4Address }) continue
+                val info = command(listOf("iw","dev",name,"info"))
+                if(!Regex("(?m)^\\s*type AP\\s*$").containsMatchIn(info) && !name.matches(Regex("(?i)(wlan|ap|swlan|wifi)[0-9]+|.*softap.*"))) continue
+                if(frequency==0) frequency=LegacyHotspotRadio.read(name,out.optString("band")).frequencyMHz ?: 0
+                if(frequency==0) frequency=Regex("channel \\d+ \\((\\d+) MHz\\)").find(info)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+                links.put(JSONObject().put("name",name).put("mac",i.hardwareAddress?.joinToString(":") { "%02x".format(it.toInt() and 255) }))
+                command(listOf("ip","neigh","show","dev",name)).lineSequence().forEach { line ->
+                    if(line.contains("lladdr") && !line.contains("FAILED") && !line.contains("INCOMPLETE")) line.substringBefore(' ').takeIf { it.isNotBlank() }?.let(ips::add)
+                }
+            }
+            out.put("interfaces",links).put("frequency",frequency).put("channel",if(frequency>0) wifiFrequencyMhzToChannel(frequency) else 0)
+                .put("clients",JSONArray(ips.toList())).put("clientCount",clients)
+                .put("dhcp",if(tethered.isNotEmpty()) "system_tethered_interface;leases_unverified" else "not_ready")
+        }
+        println("SOFTAP_JSON=$out")
+    }
+    private fun command(args: List<String>): String = runCatching {
+        val p = ProcessBuilder(args).redirectErrorStream(true).start()
+        try { if(!p.waitFor(1,TimeUnit.SECONDS)) "" else p.inputStream.bufferedReader().readText().take(16384) } finally { p.destroy() }
+    }.getOrDefault("")
+}
diff --git a/shared/src/main/java/com/shilapi/xcertplay/network/SessionSoftApManager.kt b/shared/src/main/java/com/shilapi/xcertplay/network/SessionSoftApManager.kt
