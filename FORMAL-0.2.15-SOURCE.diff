@@ -0,0 +1,35 @@
+package com.shilapi.xcertplay
+
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], qualifiers = "w1920dp-h720dp-land-mdpi")
+class PsaWideHomeTest {
+    @Test fun requiredHomeActionsFit1920By720() = checkHome()
+    @Test @Config(qualifiers = "w1280dp-h480dp-land-hdpi") fun actionsFitAt240Dpi() = checkHome()
+    @Test @Config(qualifiers = "w960dp-h360dp-land-xhdpi") fun actionsFitAt320Dpi() = checkHome()
+
+    private fun checkHome() {
+        val activity = Robolectric.buildActivity(DiPlayActivity::class.java).get()
+        DiPlayActivity::class.java.getDeclaredMethod("render").apply { isAccessible = true }.invoke(activity)
+        val root = activity.findViewById<ViewGroup>(android.R.id.content)
+        root.measure(View.MeasureSpec.makeMeasureSpec(1920, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(720, View.MeasureSpec.EXACTLY))
+        root.layout(0, 0, 1920, 720)
+        fun descendants(v: View): List<View> = listOf(v) + if (v is ViewGroup) (0 until v.childCount).flatMap { descendants(v.getChildAt(it)) } else emptyList()
+        val all = descendants(root)
+        listOf("连接手机", "蓝牙设备列表", "Wi-Fi 设置", "系统热点设置", "连接配置", "连接诊断 / USB").forEach { title ->
+            val control = all.filterIsInstance<TextView>().single { it.text.toString() == title }
+            val rect = android.graphics.Rect()
+            assertTrue(title, control.getGlobalVisibleRect(rect))
+            assertTrue("$title clipped: $rect", rect.width() >= control.width && rect.height() >= control.height)
+        }
+    }
+}
diff --git a/common/src/test/java/com/shilapi/xcertplay/UsbNcmClosedTunTest.kt b/common/src/test/java/com/shilapi/xcertplay/UsbNcmClosedTunTest.kt
new file mode 100644
index 0000000..b715877
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/UsbNcmClosedTunTest.kt
@@ -0,0 +1,57 @@
+package com.shilapi.xcertplay
+
+import android.os.ParcelFileDescriptor
+import com.shilapi.xcertplay.network.Ipv6NcmBridge
+import com.shilapi.xcertplay.transport.NcmUsbBridge
+import java.lang.reflect.InvocationTargetException
+import java.util.concurrent.atomic.AtomicBoolean
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.mockito.Mockito.*
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.annotation.Config
+
+/** Reproduce USB teardown before either NCM/TUN worker acquires its descriptor. */
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28, 33], manifest = Config.NONE)
+class UsbNcmClosedTunTest {
+    @Test fun inboundClosedTunUsesExistingTransportErrorCallback() = closedTun("runNcmToTun", true)
+    @Test fun outboundClosedTunUsesExistingTransportErrorCallback() = closedTun("runTunToNcm", true)
+    @Test fun inboundClosedTunAfterStopDoesNotReportAnotherFailure() = closedTun("runNcmToTun", false)
+    @Test fun outboundClosedTunAfterStopDoesNotReportAnotherFailure() = closedTun("runTunToNcm", false)
+
+    private fun closedTun(worker: String, running: Boolean) {
+        val pipe = ParcelFileDescriptor.createPipe()
+        val tun = pipe[0]
+        try {
+            tun.close()
+            // This is a real closed Android descriptor, not a mocked constructor failure.
+            assertTrue(runCatching { tun.fileDescriptor }.exceptionOrNull() is IllegalStateException)
+            val ncm = mock(NcmUsbBridge::class.java)
+            val errors = mutableListOf<Throwable>()
+            val bridge = Ipv6NcmBridge(ncm, tun, ByteArray(6)) { errors += it }
+            (Ipv6NcmBridge::class.java.getDeclaredField("running")
+                .apply { isAccessible = true }.get(bridge) as AtomicBoolean).set(running)
+            val escaped = try {
+                Ipv6NcmBridge::class.java.getDeclaredMethod(worker)
+                    .apply { isAccessible = true }.invoke(bridge)
+                null
+            } catch (error: InvocationTargetException) {
+                error.cause
+            }
+            if (System.getenv("USB_EXPECT_BASELINE_CRASH") == "1") {
+                // Executed against the untouched pinned baseline by Actions.
+                assertTrue("Baseline exception must escape $worker", escaped is IllegalStateException)
+                assertTrue(errors.isEmpty())
+            } else {
+                assertNull("USB worker must not leak a closed-TUN exception", escaped)
+                assertEquals(if (running) 1 else 0, errors.size)
+                if (running) assertTrue(errors.single() is IllegalStateException)
+            }
+            verifyNoInteractions(ncm)
+        } finally {
+            pipe[1].close()
+        }
+    }
+}
