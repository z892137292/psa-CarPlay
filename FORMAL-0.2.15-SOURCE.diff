new file mode 100644
index 0000000..e3e1f96
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/PsaHomeLayout.kt
@@ -0,0 +1,6 @@
+package com.shilapi.xcertplay
+
+/** Short, wide head units use a single row of connection cards. */
+object PsaHomeLayout {
+    fun compact(widthDp: Int, heightDp: Int): Boolean = widthDp >= 600 && heightDp > 0 && widthDp.toFloat() / heightDp >= 2.4f
+}
