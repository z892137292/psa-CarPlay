+package com.shilapi.xcertplay.media
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MicrophoneInputSourceTest {
+    @Test fun defaultAndUnknownChoicesPreserveEverySessionSource() {
+        for (choice in listOf(null, "auto", "invalid")) {
+            assertEquals(7, MicrophoneInputSource.resolve("telephony", choice))
+            assertEquals(6, MicrophoneInputSource.resolve("speechrecognition", choice))
+            assertEquals(1, MicrophoneInputSource.resolve("default", choice))
+        }
+    }
+    @Test fun explicitChoicesAreOptInAndIndependentOfSessionType() {
+        for (type in listOf("telephony", "speechrecognition", "default")) {
+            assertEquals(1, MicrophoneInputSource.resolve(type, "mic"))
+            assertEquals(6, MicrophoneInputSource.resolve(type, "speechrecognition"))
+            assertEquals(7, MicrophoneInputSource.resolve(type, "voicecommunication"))
+        }
+    }
+    @Test fun nativeFailureWithoutExceptionCannotPassStartupGate() {
+        var starts = 0
+        var successPublished = false
+        try {
+            MicrophoneRecordingState.startAndVerify({ starts++ }, { 1 })
+            successPublished = true
+            fail("STOPPED must fail even when the native start wrapper did not throw")
+        } catch (_: IllegalStateException) { }
+        assertEquals(1, starts)
+        assertFalse(successPublished)
+    }
+    @Test fun recordingStatePassesAndStartExceptionPropagates() {
+        assertEquals(3, MicrophoneRecordingState.startAndVerify({}, { 3 }))
+        val error = IllegalStateException("native start exception")
+        try {
+            MicrophoneRecordingState.startAndVerify({ throw error }, { 3 })
+            fail("start failure must propagate")
+        } catch (actual: IllegalStateException) { assertSame(error, actual) }
+    }
+}
