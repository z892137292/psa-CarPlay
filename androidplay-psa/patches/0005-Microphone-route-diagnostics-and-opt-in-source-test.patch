+package com.shilapi.xcertplay.media
+
+import java.util.Locale
+
+/** Optional diagnostic input choice. AUTO preserves the original per-session mapping. */
+internal object MicrophoneInputSource {
+    fun normalize(value: String?): String = when (value?.lowercase(Locale.ROOT)) {
+        "mic" -> "mic"
+        "speechrecognition" -> "speechrecognition"
+        "voicecommunication" -> "voicecommunication"
+        else -> "auto"
+    }
+
+    fun resolve(audioType: String, override: String? = null): Int = when (normalize(override)) {
+        "mic" -> 1
+        "speechrecognition" -> 6
+        "voicecommunication" -> 7
+        else -> when (audioType) {
+            "telephony" -> 7
+            "speechrecognition" -> 6
+            else -> 1
+        }
+    }
+}
+
+/** A void startRecording() call may return without entering RECORDING on API28. */
+internal object MicrophoneRecordingState {
+    fun startAndVerify(start: () -> Unit, state: () -> Int): Int {
+        start()
+        val actual = state()
+        check(actual == 3) { "microphone did not enter RECORDSTATE_RECORDING recordingState=$actual" }
+        return actual
+    }
+}
