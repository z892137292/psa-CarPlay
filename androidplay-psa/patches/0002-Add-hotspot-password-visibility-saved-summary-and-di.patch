diff --git a/common/src/main/java/com/shilapi/xcertplay/HotspotConfigurationSource.kt b/common/src/main/java/com/shilapi/xcertplay/HotspotConfigurationSource.kt
new file mode 100644
index 0000000..644b523
--- /dev/null
+++ b/common/src/main/java/com/shilapi/xcertplay/HotspotConfigurationSource.kt
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package com.shilapi.xcertplay
+
+import android.content.Context
+import java.security.MessageDigest
+
+/** Only claim an origin for the exact credentials observed by this version. */
+internal object HotspotConfigurationSource {
+    private fun fingerprint(context: Context): String {
+        val ssid = AirPlayPersistence.loadManualHotspotSsid(context)
+        val password = AirPlayPersistence.loadManualHotspotPassphrase(context)
+        return MessageDigest.getInstance("SHA-256")
+            .digest("${ssid.length}:$ssid$password".toByteArray(Charsets.UTF_8))
+            .joinToString("") { "%02x".format(it.toInt() and 0xff) }
+    }
+
+    fun record(context: Context, automatic: Boolean) {
+        context.getSharedPreferences("androidplay_hotspot_origin", Context.MODE_PRIVATE).edit()
+            .putString("fingerprint", fingerprint(context))
+            .putBoolean("automatic", automatic).apply()
+    }
+
+    fun label(context: Context): String? {
+        val prefs = context.getSharedPreferences("androidplay_hotspot_origin", Context.MODE_PRIVATE)
+        if (prefs.getString("fingerprint", null) != fingerprint(context)) return null
+        return if (prefs.getBoolean("automatic", false)) "自动获取" else "手动填写"
+    }
+}
