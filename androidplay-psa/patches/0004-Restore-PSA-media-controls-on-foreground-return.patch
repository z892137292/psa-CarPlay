@@ -0,0 +1,35 @@
+package com.shilapi.xcertplay
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class MediaKeyGateTest {
+    @Test fun duplicateDeliveryAndKeyRepeatProduceOneCommand() {
+        val keys = MediaKeyGate()
+        assertEquals(4, keys.command(87, 0, 0, 100, 1, true))
+        assertNull(keys.command(87, 0, 0, 100, 1, true))
+        assertNull(keys.command(87, 0, 1, 100, 1, true))
+        assertNull(keys.command(87, 1, 0, 100, 1, true))
+        assertEquals(4, keys.command(87, 0, 0, 101, 1, true))
+    }
+
+    @Test fun publicMediaKeysMapToExistingPhoneCommands() {
+        val keys = MediaKeyGate()
+        assertEquals(5, keys.command(88, 0, 0, 1, 1, true))
+        assertEquals(1, keys.command(126, 0, 0, 2, 1, false))
+        assertEquals(2, keys.command(127, 0, 0, 3, 1, true))
+        assertEquals(2, keys.command(85, 0, 0, 4, 1, true))
+        assertEquals(1, keys.command(85, 0, 0, 5, 1, false))
+        assertFalse(keys.supports(26))
+        assertNull(keys.command(26, 0, 0, 6, 1, true))
+    }
+
+    @Test fun reconnectResetsDeduplication() {
+        val keys = MediaKeyGate()
+        assertEquals(4, keys.command(87, 0, 0, 1, 1, true))
+        keys.reset()
+        assertEquals(4, keys.command(87, 0, 0, 1, 1, true))
+    }
+}
