@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+package com.shilapi.xcertplay
+
+/** Deduplicates one physical DOWN delivered through both receiver and session callback. */
+internal class MediaKeyGate {
+    private data class Press(val key: Int, val downTime: Long, val device: Int)
+    private var last: Press? = null
+
+    fun supports(key: Int) = key in listOf(85, 87, 88, 126, 127)
+
+    fun command(key: Int, action: Int, repeat: Int, downTime: Long, device: Int, playing: Boolean): Int? {
+        if (!supports(key) || action != KeyEventActionDown || repeat != 0) return null
+        val press = Press(key, downTime, device)
+        if (last == press) return null
+        last = press
+        return when (key) {
+            87 -> 4
+            88 -> 5
+            126 -> 1
+            127 -> 2
+            else -> if (playing) 2 else 1
+        }
+    }
+
+    fun reset() { last = null }
+
+    private companion object { const val KeyEventActionDown = 0 }
+}
diff --git a/common/src/test/java/com/shilapi/xcertplay/MediaControlOwnershipTest.kt b/common/src/test/java/com/shilapi/xcertplay/MediaControlOwnershipTest.kt
new file mode 100644
index 0000000..27aad9b
--- /dev/null
+++ b/common/src/test/java/com/shilapi/xcertplay/MediaControlOwnershipTest.kt
@@ -0,0 +1,84 @@
+package com.shilapi.xcertplay
+
+import android.media.AudioManager
+import android.media.session.MediaSession
+import android.os.Looper
+import android.view.KeyEvent
+import com.shilapi.xcertplay.media.CarPlayNowPlaying
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.shadow.api.Shadow
+import org.robolectric.util.ReflectionHelpers
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [28], manifest = Config.NONE, shadows = [RecordingMediaSession::class])
+class MediaControlOwnershipTest {
+    private fun idle() = shadowOf(Looper.getMainLooper()).idle()
+
+    @Test fun tenReversibleTransitionsDoNotReclaimOnMetadataOrRepeatResume() {
+        val context = RuntimeEnvironment.getApplication()
+        val audio = shadowOf(context.getSystemService(AudioManager::class.java))
+        audio.setNextFocusRequestResponse(AudioManager.AUDIOFOCUS_REQUEST_GRANTED)
+        val commands = mutableListOf<Int>()
+        val publisher = AndroidPlayMediaSession(context, { commands += it }, {}, {})
+        publisher.setForeground(true)
+        publisher.update(CarPlayNowPlaying(revision = 1, title = "Song", playing = true))
+        idle()
+        val platform = ReflectionHelpers.getField<MediaSession>(publisher, "session")
+        repeat(10) { turn ->
+            assertTrue(platform.isActive)
+            publisher.setForeground(false)
+            idle()
+            audio.lastAudioFocusRequest.listener.onAudioFocusChange(AudioManager.AUDIOFOCUS_LOSS)
+            assertFalse(platform.isActive)
+            publisher.update(CarPlayNowPlaying(revision = (turn + 2).toLong(), title = "Song", playing = true))
+            idle()
+            assertFalse(platform.isActive)
+            publisher.setForeground(true)
+            idle()
+            assertTrue(platform.isActive)
+            val request = audio.lastAudioFocusRequest
+            publisher.setForeground(true)
+            idle()
+            assertSame(request, audio.lastAudioFocusRequest)
+            val time = 100L + turn
+            publisher.receiveMediaButton(KeyEvent(time, time, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MEDIA_NEXT, 0))
+            publisher.receiveMediaButton(KeyEvent(time, time, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_MEDIA_NEXT, 0))
+        }
+        assertEquals(List(10) { 4 }, commands)
+        publisher.close()
+        assertFalse(platform.isActive)
+        assertNotNull(audio.lastAbandonedAudioFocusRequest)
+    }
+
+    @Test fun focusDenialDoesNotRetryOnMetadataOrForwardCallbacks() {
+        val context = RuntimeEnvironment.getApplication()
+        val audio = shadowOf(context.getSystemService(AudioManager::class.java))
+        audio.setNextFocusRequestResponse(AudioManager.AUDIOFOCUS_REQUEST_FAILED)
+        val commands = mutableListOf<Int>()
+        val publisher = AndroidPlayMediaSession(context, { commands += it }, {}, {})
+        publisher.setForeground(true)
+        publisher.update(CarPlayNowPlaying(revision = 1, title = "Song", playing = true))
+        idle()
+        val platform = ReflectionHelpers.getField<MediaSession>(publisher, "session")
+        val callback = Shadow.extract<RecordingMediaSession>(platform).callback!!
+        assertFalse(platform.isActive)
+        val request = audio.lastAudioFocusRequest
+        publisher.update(CarPlayNowPlaying(revision = 2, title = "Song", playing = true))
+        idle()
+        assertSame(request, audio.lastAudioFocusRequest)
+        callback.onPause()
+        publisher.close()
+        callback.onSkipToPrevious()
+        assertTrue(commands.isEmpty())
+    }
+}
