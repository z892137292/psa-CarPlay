+
+/** Android 9 ap0 compatibility trial; other interfaces and OS versions retain their policy. */
+internal fun manualHotspotHostAddress(
+    addresses: List<InetAddress>,
+    interfaceIndex: Int,
+    interfaceName: String,
+    sdkInt: Int,
+): InetAddress? {
+    if (sdkInt == 28 && interfaceName == "ap0") {
+        addresses.firstOrNull {
+            it is Inet4Address && !it.isLoopbackAddress && !it.isLinkLocalAddress &&
+                !it.isAnyLocalAddress && !it.isMulticastAddress
+        }?.let { return it }
+    }
+    return wirelessHostAddress(addresses, interfaceIndex)
+}
