@@ -0,0 +1,32 @@
+package com.shilapi.xcertplay.network
+
+import java.net.Inet4Address
+import java.net.Inet6Address
+import java.net.InetAddress
+import org.junit.Assert.*
+import org.junit.Test
+
+class ManualHotspotHostAddressTest {
+    private val ipv4 = InetAddress.getByName("10.42.7.1")
+    private val ipv6 = InetAddress.getByName("fe80::1")
+
+    @Test fun android9Ap0UsesActualIpv4RegardlessOfEnumerationOrder() {
+        for (addresses in listOf(listOf(ipv6, ipv4), listOf(ipv4, ipv6))) {
+            assertEquals(ipv4, manualHotspotHostAddress(addresses, 7, "ap0", 28))
+        }
+    }
+    @Test fun missingIpv4FallsBackToScopedIpv6() {
+        val result = manualHotspotHostAddress(listOf(ipv6), 7, "ap0", 28) as Inet6Address
+        assertEquals(7, result.scopeId)
+    }
+    @Test fun otherModesKeepIpv6Preference() {
+        for ((name, sdk) in listOf("ap0" to 29, "ap1" to 28, "wlan0" to 28, "p2p0" to 28)) {
+            assertTrue(manualHotspotHostAddress(listOf(ipv4, ipv6), 7, name, sdk) is Inet6Address)
+        }
+    }
+    @Test fun unusableIpv4IsRejected() {
+        val rejected = listOf("127.0.0.1", "169.254.2.1", "0.0.0.0", "224.0.0.1").map(InetAddress::getByName)
+        assertNull(manualHotspotHostAddress(rejected, 7, "ap0", 28))
+        assertTrue(manualHotspotHostAddress(rejected + ipv4, 7, "ap0", 28) is Inet4Address)
+    }
+}
